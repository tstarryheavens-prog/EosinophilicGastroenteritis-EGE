---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'ja' | 'en';
  enSlug?: string;
  originalJaSlug?: string;
}

const {
  title = "好酸球性胃腸炎と複合難病の闘病・服薬ノート",
  description = "好酸球性消化管疾患・群発頭痛・重症喘息・小麦アレルギーと生きる当事者のリアルな闘病・服薬記録と最新治療調査ノート。",
  image = "https://assets.st-note.com/production/uploads/images/194838258/rectangle_large_type_2_d898657663115a59629819f3887dab55.png",
  article = false,
  lang = "ja",
  enSlug,
  originalJaSlug
} = Astro.props;

const siteName = lang === "en"
  ? "Eosinophilic Gastroenteritis & Intractable Disease Real-World Evidence Portal"
  : "好酸球性胃腸炎と複合難病の闘病・服薬ノート";

const defaultTitle = lang === "en"
  ? "Eosinophilic Gastroenteritis & Intractable Disease Real-World Evidence Portal"
  : "好酸球性胃腸炎と複合難病の闘病・服薬ノート";

const siteTitle = title === defaultTitle || title.includes("好酸球性胃腸炎") || title.includes("Eosinophilic Gastroenteritis")
  ? title
  : `${title} | ${siteName}`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_ID || "ca-pub-1988464307898443";

// Hreflang logic
const path = Astro.url.pathname;
let jaUrl = "";
let enUrl = "";

if (lang === "en") {
  enUrl = canonicalURL.toString();
  if (originalJaSlug) {
    jaUrl = new URL(`/blog/${originalJaSlug}`, Astro.site).toString();
  } else if (path === "/en" || path === "/en/") {
    jaUrl = new URL("/", Astro.site).toString();
  } else if (path.startsWith("/en/research-database")) {
    jaUrl = new URL("/research-database", Astro.site).toString();
  } else if (path.startsWith("/en/clinical-analytics")) {
    jaUrl = new URL("/clinical-analytics", Astro.site).toString();
  }
} else {
  jaUrl = canonicalURL.toString();
  if (enSlug) {
    enUrl = new URL(`/en/blog/${enSlug}`, Astro.site).toString();
  } else if (path === "/" || path === "") {
    enUrl = new URL("/en/", Astro.site).toString();
  } else if (path.startsWith("/research-database")) {
    enUrl = new URL("/en/research-database", Astro.site).toString();
  } else if (path.startsWith("/clinical-analytics")) {
    enUrl = new URL("/en/clinical-analytics", Astro.site).toString();
  }
}
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- Multi-Language SEO (Hreflang Tags) -->
    {jaUrl && <link rel="alternate" hreflang="ja" href={jaUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {enUrl ? (
      <link rel="alternate" hreflang="x-default" href={enUrl} />
    ) : (
      <link rel="alternate" hreflang="x-default" href={jaUrl} />
    )}

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#E07A5F" />

    <!-- Google Fonts: Zen Maru Gothic (丸ゴシック・ユニバーサルデザイン) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- OGP / Social -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="好酸球性胃腸炎と複合難病の闘病・服薬ノート" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS & Sitemap -->
    <link rel="alternate" type="application/rss+xml" title="好酸球性胃腸炎と複合難病の闘病・服薬ノート RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- 文字サイズ設定の即時復元（ちらつき防止） -->
    <script is:inline>
      try {
        if (localStorage.getItem('fontSize') === 'large') {
          document.documentElement.classList.add('font-large');
        }
      } catch (e) {}
    </script>

    <!-- A8 Link Manager -->
    <script is:inline src="//statics.8me.jp/a8link/a8linkmgr.js"></script>
    <script is:inline>
      a8linkmgr({
        "config_id": "AiCzxW5LM9avBb8VJ393"
      });
    </script>

    <!-- Google AdSense Script & Meta Tag (AdSense承認・自動広告用) -->
    {adsenseClient && !adsenseClient.includes("XXXX") && (
      <>
        <meta name="google-adsense-account" content={adsenseClient} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        ></script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#FDFBF7] text-[#3D3A35] antialiased selection:bg-[#E07A5F]/20 selection:text-[#3D3A35]">
<!-- AI_COMPANY_MUTUAL_NETWORK_START -->
<div id="ai-company-network-bar" style="background:linear-gradient(90deg,#0f172a,#1e293b);color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:12px;padding:8px 16px;border-bottom:1px solid #334155;position:relative;z-index:9999;">
  <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;">
    <div style="display:flex;align-items:center;gap:6px;font-weight:700;">
      <span>🐼 AIカンパニー相互ネットワーク:</span>
      <a href="https://ai-living-lab.pages.dev" target="_blank" rel="noopener" style="color:#38bdf8;text-decoration:none;background:rgba(56,189,248,0.15);padding:3px 8px;border-radius:6px;">🏠 Smart AI Life (本社ハブ)</a>
      <a href="https://ai-living-lab.pages.dev/divisions/nanbyo" target="_blank" rel="noopener" style="color:#a5b4fc;text-decoration:none;background:rgba(165,180,252,0.15);padding:3px 8px;border-radius:6px;">📚 好酸球性胃腸炎・難病ポータル 特集記事アーカイブ</a>
    </div>
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:11.5px;">
      <a href="https://ikomainagoyaaichihighschool.pages.dev" target="_blank" rel="noopener" style="color:#cbd5e1;text-decoration:none;">🎓 愛知高校受験ナビ</a>
      <a href="https://mytoyotahomebottle.pages.dev" target="_blank" rel="noopener" style="color:#cbd5e1;text-decoration:none;">🏠 トヨタホーム10年実録</a>
      <a href="https://eosinophilicgastroenteritis-ege.pages.dev" target="_blank" rel="noopener" style="color:#cbd5e1;text-decoration:none;">🩺 難病・好酸球性胃腸炎ノート</a>
      <a href="https://corestation.pages.dev" target="_blank" rel="noopener" style="color:#cbd5e1;text-decoration:none;">💻 CoreStation</a>
      <a href="https://kurashi-ai.hatenadiary.com/" target="_blank" rel="noopener" style="color:#cbd5e1;text-decoration:none;">📝 公式はてな</a>
    </div>
  </div>
</div>
<!-- AI_COMPANY_MUTUAL_NETWORK_END -->
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  <!-- AI_COMPANY_EMDASH_FEED_START -->
<section id="emdash-live-feed-section" style="max-width:1100px;margin:36px auto;padding:24px 20px;background:#ffffff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 4px 16px rgba(15,23,42,0.05);font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#0f172a;">
  <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;">
    <div>
      <span style="display:inline-block;background:#eff6ff;color:#1e40af;font-size:11px;font-weight:800;padding:3px 10px;border-radius:999px;margin-bottom:4px;">🐼 Smart AI Life リアルタイム連動アーカイブ</span>
      <h2 style="font-size:18px;font-weight:800;margin:0;color:#0f172a;">📚 好酸球性胃腸炎・難病ポータル 統合記事アーカイブ（最新特集）</h2>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="https://ai-living-lab.pages.dev/divisions/nanbyo" target="_blank" rel="noopener" style="background:#1e40af;color:#fff;font-size:12px;font-weight:700;padding:8px 14px;border-radius:8px;text-decoration:none;">事業部ポータルで全記事を見る ➔</a>
      <a href="https://ai-living-lab.pages.dev" target="_blank" rel="noopener" style="background:#f8fafc;color:#334155;border:1px solid #cbd5e1;font-size:12px;font-weight:700;padding:8px 14px;border-radius:8px;text-decoration:none;">Smart AI Life 本社へ ↗</a>
    </div>
  </div>
  <div id="emdash-feed-grid-nanbyo" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;">
    <p style="font-size:13px;color:#64748b;">最新記事を読み込み中...</p>
  </div>
</section>
<script>
(function(){
  var grid = document.getElementById('emdash-feed-grid-nanbyo');
  if (!grid) return;
  fetch('https://ai-living-lab.pages.dev/_emdash/api/content/posts?site_id=nanbyo&limit=6')
    .then(function(r){ return r.json(); })
    .then(function(res){
      var items = (res && res.data && res.data.items) ? res.data.items.slice(0, 6) : [];
      if (!items.length) {
        grid.innerHTML = '<p style="font-size:13px;color:#64748b;">記事一覧は <a href="https://ai-living-lab.pages.dev/divisions/nanbyo" target="_blank" style="color:#1e40af;font-weight:700;">Smart AI Life 事業部ページ</a> からご覧いただけます。</p>';
        return;
      }
      grid.innerHTML = items.map(function(it){
        var url = 'https://ai-living-lab.pages.dev/articles/' + encodeURIComponent(it.slug || it.id);
        var title = (it.title || '記事詳細').replace(/</g, '&lt;');
        var excerpt = ((it.excerpt || (it.data && it.data.excerpt) || '') + '').replace(/</g, '&lt;').slice(0, 80);
        return '<a href="' + url + '" target="_blank" rel="noopener" style="display:flex;flex-direction:column;justify-content:space-between;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px;text-decoration:none;color:inherit;transition:all 0.15s ease;">' +
          '<div><div style="font-size:10px;font-weight:700;color:#0284c7;margin-bottom:4px;">最新特集記事</div>' +
          '<h3 style="font-size:14px;font-weight:800;color:#0f172a;margin:0 0 6px 0;line-height:1.4;">' + title + '</h3>' +
          '<p style="font-size:12px;color:#64748b;margin:0 0 10px 0;line-height:1.5;">' + excerpt + '...</p></div>' +
          '<div style="font-size:12px;font-weight:700;color:#1e40af;">全文を読む ➔</div></a>';
      }).join('');
    })
    .catch(function(){
      grid.innerHTML = '<p style="font-size:13px;color:#64748b;"><a href="https://ai-living-lab.pages.dev/divisions/nanbyo" target="_blank" style="color:#1e40af;font-weight:700;">📚 Smart AI Life 統合記事アーカイブを開く ↗</a></p>';
    });
})();
</script>
<!-- AI_COMPANY_EMDASH_FEED_END -->
</body>
</html>
