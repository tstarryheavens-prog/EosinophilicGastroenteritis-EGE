---
import NetworkHeader from '../components/NetworkHeader.astro';
import NetworkFooter from '../components/NetworkFooter.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  fullWidth?: boolean;
}

const {
  title = 'Smart AI Life ｜ 暮らしとAIの実験室',
  description = '電気代削減・自作HEMS・100歳家計シミュレーション・書類の自動仕分け・難病と健康管理まで。生成AIと自作ツールで暮らしをゆたかに自動化するマガジン。',
  lang = 'ja',
  hideHeader = false,
  hideFooter = false,
  fullWidth = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEn = lang === 'en' || currentPath.startsWith('/en');
const siteBase = 'https://eosinophilicgastroenteritis-ege.pages.dev';
const enUrl = isEn ? new URL(currentPath, siteBase).href : new URL('/en' + currentPath, siteBase).href;
const jaUrl = isEn ? new URL(currentPath.replace(/^\/en/, '') || '/', siteBase).href : new URL(currentPath, siteBase).href;
---

<!doctype html>
<html lang={isEn ? 'en' : 'ja'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ぽトル (Pottle) / Smart AI Life" />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteBase).href} />

    <!-- Multilingual hreflang -->
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph / OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteBase).href} />
    <meta property="og:site_name" content="Smart AI Life ｜ 難病・好酸球性胃腸炎統合ポータル" />
    <meta property="og:image" content={`${siteBase}/pottle_header_with_title.jpg`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteBase}/pottle_header_with_title.jpg`} />

    <!-- Nabu Casa Design System Fonts: Outfit + Source Serif 4 + Noto Sans/Serif JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@300;400;500&family=Outfit:wght@300;400;450;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300&display=swap" rel="stylesheet" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1988464307898443" crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-46BPFDBH6V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-46BPFDBH6V');
    </script>
  </head>
  <body>
    {!hideHeader && <NetworkHeader />}
    <main id="main-content" class={fullWidth ? 'full-width-main' : ''}>
      <slot />
    </main>
    {!hideFooter && <NetworkFooter />}
    <CodeBlockEnhancer />
  </body>
</html>

<style is:global>
  /* ======================================================== */
  /* Nabu Casa Support Design System (EmDash / Smart AI Life) */
  /* ======================================================== */
  :root {
    --nc-font-sans: "Outfit", "Noto Sans JP", -apple-system, BlinkMacSystemFont, sans-serif;
    --nc-font-serif: "Source Serif 4", "Source Serif", "Noto Serif JP", Georgia, serif;

    --nc-color-white: #ffffff;
    --nc-color-light-gray: #f0f1f1;
    --nc-color-gray: #ecebe7;
    --nc-color-taupe: #8f8e82;
    --nc-color-charcoal: #1f1f1c;
    --nc-color-orange: #ec7523;
    --nc-color-sun: #ffde77;
    --nc-color-tin: #a8b7cd;
    --nc-color-green: #559361;
    --nc-color-highlight: #c05811;

    --nc-radius-md: 1rem;
    --nc-gutter: 1.25rem;
    --nc-section-gap: 2rem;
    --nc-stack-gap: 1rem;
    --nc-card-padding: 1.5rem;

    --nc-ring: 0 0 0 1px var(--nc-color-charcoal), 0 0 0 2px var(--nc-color-charcoal), 0 0 0 3px var(--nc-color-charcoal);
    --nc-ring-sun: 0 0 0 1px var(--nc-color-sun), 0 0 0 2px var(--nc-color-sun), 0 0 0 3px var(--nc-color-sun);

    /* Legacy token aliases mapped to Nabu Casa palette */
    --bg-page: var(--nc-color-white);
    --bg-card: var(--nc-color-gray);
    --bg-card-subtle: var(--nc-color-light-gray);
    --border-color: var(--nc-color-gray);
    --border-strong: var(--nc-color-taupe);
    --text-heading: var(--nc-color-charcoal);
    --text-body: var(--nc-color-charcoal);
    --text-muted: #4b4a44;
    --text-subtle: var(--nc-color-taupe);
    --primary: var(--nc-color-charcoal);
    --primary-hover: var(--nc-color-orange);
    --primary-light: var(--nc-color-sun);

    --accent-emerald: var(--nc-color-green);
    --accent-amber: var(--nc-color-orange);
    --accent-teal: var(--nc-color-tin);
    --accent-indigo: var(--nc-color-charcoal);
  }

  @media (min-width: 768px) {
    :root {
      --nc-gutter: 2rem;
      --nc-section-gap: 3rem;
      --nc-stack-gap: 1.25rem;
      --nc-card-padding: 2rem;
    }
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
    font-size: 16px;
    height: 100%;
  }

  body {
    font-family: var(--nc-font-sans);
    font-size: 1rem;
    font-weight: 350;
    line-height: 1.55;
    background-color: var(--nc-color-white);
    color: var(--nc-color-charcoal);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  main#main-content {
    flex: 1 0 auto;
  }

  main.full-width-main {
    max-width: 100vw;
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
  }

  a {
    color: var(--nc-color-charcoal);
    text-decoration: none;
    transition: color 0.15s ease, text-decoration-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  a:hover {
    color: var(--nc-color-charcoal);
    text-decoration: underline;
    text-decoration-color: var(--nc-color-orange);
    text-underline-offset: 0.25em;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--nc-font-sans);
    color: var(--nc-color-charcoal);
    font-weight: 450;
    margin-top: 0;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.25rem, 1.8rem + 2.2vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: clamp(1.65rem, 1.4rem + 1.1vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  h3 {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.65rem);
    line-height: 1.22;
  }

  h4 {
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.35rem);
    line-height: 1.28;
  }

  strong, b {
    font-weight: 600;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  :focus-visible {
    outline: 2px solid var(--nc-color-orange);
    outline-offset: 2px;
  }

  /* ======================================================== */
  /* Nabu Casa Layout Containers & Sections                   */
  /* ======================================================== */
  .container,
  .nc-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--nc-gutter);
  }

  .section,
  .nc-section {
    margin-bottom: var(--nc-section-gap);
  }

  .eyebrow,
  .nc-eyebrow {
    font-family: var(--nc-font-serif);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    font-weight: 300;
    line-height: 1.35;
    margin: 0 0 0.5rem;
    color: var(--nc-color-taupe);
  }

  /* ======================================================== */
  /* Nabu Casa Buttons (.btn, .btn-dark, .btn-light, .btn-primary) */
  /* ======================================================== */
  .btn,
  .nc-btn {
    background-color: var(--nc-color-gray);
    border: 0;
    border-radius: 100px;
    color: var(--nc-color-charcoal);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--nc-font-sans);
    font-size: 0.9375rem;
    font-weight: 450;
    line-height: 1.4;
    padding: 0.65rem 1.35rem;
    text-align: center;
    text-decoration: none !important;
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .btn:hover,
  .nc-btn:hover {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
    text-decoration: none !important;
  }

  .btn-primary,
  .btn-dark,
  .nc-btn-dark {
    background-color: var(--nc-color-charcoal);
    color: var(--nc-color-white);
  }

  .btn-primary:hover,
  .btn-dark:hover,
  .nc-btn-dark:hover {
    background-color: var(--nc-color-charcoal);
    box-shadow: var(--nc-ring);
    color: var(--nc-color-white);
  }

  .btn-light,
  .nc-btn-light {
    background-color: var(--nc-color-white);
    color: var(--nc-color-charcoal);
  }

  .btn-light:hover,
  .nc-btn-light:hover {
    background-color: var(--nc-color-sun);
    box-shadow: var(--nc-ring-sun);
    color: var(--nc-color-charcoal);
  }

  .btn-sun,
  .nc-btn-sun {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
  }

  .btn-sun:hover,
  .nc-btn-sun:hover {
    background-color: var(--nc-color-sun);
    box-shadow: var(--nc-ring-sun);
    color: var(--nc-color-charcoal);
  }

  /* ======================================================== */
  /* Nabu Casa Rounded Hero Banner (.section.hero / .nc-hero) */
  /* ======================================================== */
  .nc-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--nc-radius-md);
    max-width: calc(1400px - var(--nc-gutter) * 2);
    width: calc(100% - var(--nc-gutter) * 2);
    margin: var(--nc-gutter) auto 1.25rem;
    padding: clamp(2.5rem, 5vw, 4.75rem) clamp(1.5rem, 4vw, 3.5rem);
    background-color: var(--nc-color-tin);
    color: var(--nc-color-charcoal);
  }

  .nc-hero.hero-home {
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 4vw, 3.5rem);
    margin-bottom: var(--nc-section-gap);
  }

  .nc-hero.hero-tin {
    background-color: var(--nc-color-tin);
    color: var(--nc-color-charcoal);
  }

  .nc-hero.hero-sun {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
  }

  .nc-hero.hero-green {
    background-color: var(--nc-color-green);
    color: var(--nc-color-white);
  }
  .nc-hero.hero-green h1,
  .nc-hero.hero-green p,
  .nc-hero.hero-green .nc-hero-lead {
    color: var(--nc-color-white);
  }

  .nc-hero.hero-orange {
    background-color: var(--nc-color-orange);
    color: var(--nc-color-white);
  }
  .nc-hero.hero-orange h1,
  .nc-hero.hero-orange p,
  .nc-hero.hero-orange .nc-hero-lead {
    color: var(--nc-color-white);
  }

  .nc-hero.hero-charcoal {
    background-color: var(--nc-color-charcoal);
    color: var(--nc-color-white);
  }
  .nc-hero.hero-charcoal h1,
  .nc-hero.hero-charcoal p,
  .nc-hero.hero-charcoal .nc-hero-lead {
    color: var(--nc-color-white);
  }

  .nc-hero.hero-gray {
    background-color: var(--nc-color-gray);
    color: var(--nc-color-charcoal);
  }

  .nc-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .nc-hero-title {
    font-family: var(--nc-font-sans);
    font-size: clamp(2.35rem, 1.9rem + 2.8vw, 4.25rem);
    font-weight: 450;
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .nc-hero-lead {
    font-family: var(--nc-font-serif);
    font-size: clamp(1.0625rem, 1rem + 0.45vw, 1.375rem);
    font-weight: 300;
    line-height: 1.45;
    margin: 0;
    opacity: 0.92;
  }

  /* ======================================================== */
  /* Nabu Casa Sub-Hero Row (Breadcrumbs + Pill Search Bar)   */
  /* ======================================================== */
  .nc-sub-hero {
    max-width: 1400px;
    margin: 0 auto var(--nc-section-gap);
    padding: 0 var(--nc-gutter);
  }

  .nc-sub-hero-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .nc-sub-hero-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .nc-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--nc-color-taupe);
  }

  .nc-breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--nc-color-taupe);
  }

  .nc-breadcrumbs li + li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 10px;
    background-color: var(--nc-color-charcoal);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    margin-right: 0.2rem;
    opacity: 0.75;
  }

  .nc-breadcrumbs a {
    color: var(--nc-color-charcoal);
    text-decoration: none;
    font-weight: 400;
  }

  .nc-breadcrumbs a:hover {
    text-decoration: underline;
    text-decoration-color: var(--nc-color-orange);
  }

  /* Pill Search Wrapper */
  .nc-search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 680px;
  }

  .nc-search-wrapper.small {
    max-width: 390px;
  }

  .nc-search-field {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    align-items: center;
  }

  .nc-search-field svg {
    position: absolute;
    left: 1.1rem;
    width: 18px;
    height: 18px;
    color: var(--nc-color-charcoal);
    pointer-events: none;
  }

  .nc-search-input {
    width: 100%;
    height: 52px;
    padding: 0 1.25rem 0 2.85rem;
    border: 0;
    border-radius: 100px;
    background-color: var(--nc-color-white);
    color: var(--nc-color-charcoal);
    font-family: var(--nc-font-sans);
    font-size: 0.95rem;
    font-weight: 350;
    outline: none;
    transition: box-shadow 0.2s ease;
  }

  .nc-search-input::placeholder {
    color: var(--nc-color-taupe);
  }

  .nc-search-input:focus {
    box-shadow: var(--nc-ring);
  }

  .nc-search-wrapper.small .nc-search-input {
    height: 44px;
    background-color: var(--nc-color-gray);
    font-size: 0.875rem;
  }

  .nc-search-wrapper.small .btn {
    height: 44px;
    padding: 0 1.25rem;
    font-size: 0.875rem;
  }

  /* ======================================================== */
  /* Nabu Casa Category Cards (Split Title + White Desc Box)  */
  /* ======================================================== */
  .nc-category-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--nc-stack-gap);
  }

  @media (min-width: 768px) {
    .nc-category-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .nc-category-card {
    background-color: var(--nc-color-gray);
    border-radius: var(--nc-radius-md);
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none !important;
    color: var(--nc-color-charcoal);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
  }

  .nc-category-card:hover {
    box-shadow: var(--nc-ring);
    text-decoration: none !important;
  }

  .nc-category-card-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    flex: 1;
  }

  @media (min-width: 520px) {
    .nc-category-card-content {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }

  .nc-category-card-title {
    background-color: var(--nc-color-tin);
    border-radius: calc(var(--nc-radius-md) - 0.25rem);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 150px;
  }

  .nc-category-card.sun .nc-category-card-title {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
  }

  .nc-category-card.tin .nc-category-card-title {
    background-color: var(--nc-color-tin);
    color: var(--nc-color-charcoal);
  }

  .nc-category-card.green .nc-category-card-title {
    background-color: var(--nc-color-green);
    color: var(--nc-color-white);
  }
  .nc-category-card.green .nc-category-card-title h3,
  .nc-category-card.green .nc-category-card-title span {
    color: var(--nc-color-white);
  }

  .nc-category-card.orange .nc-category-card-title {
    background-color: var(--nc-color-orange);
    color: var(--nc-color-white);
  }
  .nc-category-card.orange .nc-category-card-title h3,
  .nc-category-card.orange .nc-category-card-title span {
    color: var(--nc-color-white);
  }

  .nc-category-card.charcoal .nc-category-card-title {
    background-color: var(--nc-color-charcoal);
    color: var(--nc-color-white);
  }
  .nc-category-card.charcoal .nc-category-card-title h3,
  .nc-category-card.charcoal .nc-category-card-title span {
    color: var(--nc-color-white);
  }

  .nc-category-card-title h3 {
    font-size: 1.25rem;
    font-weight: 450;
    line-height: 1.2;
    margin: 0;
  }

  .nc-category-card-description {
    background-color: var(--nc-color-white);
    border-radius: calc(var(--nc-radius-md) - 0.25rem);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    color: var(--nc-color-charcoal);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .nc-category-card-cta {
    align-self: flex-end;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background-color: var(--nc-color-charcoal);
    color: var(--nc-color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .nc-category-card:hover .nc-category-card-cta {
    box-shadow: var(--nc-ring);
    transform: translateX(2px);
  }

  /* ======================================================== */
  /* Nabu Casa Sidebar Item Cards (.nc-item-cards / .item-card)*/
  /* ======================================================== */
  .nc-item-cards {
    display: flex;
    flex-direction: column;
    gap: var(--nc-stack-gap);
  }

  .nc-item-card {
    background-color: var(--nc-color-gray);
    border-radius: var(--nc-radius-md);
    padding: var(--nc-card-padding);
    color: var(--nc-color-charcoal);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none !important;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  a.nc-item-card:hover {
    background-color: var(--nc-color-sun);
    text-decoration: none !important;
  }

  .nc-item-card.primary {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
  }

  .nc-item-card.product {
    background-color: var(--nc-color-charcoal);
    color: var(--nc-color-white);
  }

  .nc-item-card.product h3,
  .nc-item-card.product h4,
  .nc-item-card.product p,
  .nc-item-card.product .eyebrow {
    color: var(--nc-color-white);
  }

  a.nc-item-card.product:hover {
    background-color: var(--nc-color-charcoal);
    box-shadow: var(--nc-ring);
  }

  .nc-item-card.tin {
    background-color: var(--nc-color-tin);
    color: var(--nc-color-charcoal);
  }

