---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  tags: string[];
  eyecatch?: string;
  slug: string;
  originalJaSlug?: string;
}

const { title, description, pubDate, category, tags, eyecatch, slug, originalJaSlug } = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://eosinophilicgastroenteritis-ege.pages.dev';
const postUrl = `${siteOrigin}/en/blog/${slug}`;
const homeUrl = `${siteOrigin}/en/`;
const ogImageUrl = eyecatch
  ? (eyecatch.startsWith('http') ? eyecatch : `${siteOrigin}${eyecatch.startsWith('/') ? '' : '/'}${eyecatch}`)
  : `${siteOrigin}/icon-512.png`;

// JSON-LD Structured Data for Global SEO (Schema.org)
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: [ogImageUrl],
  datePublished: pubDate,
  dateModified: pubDate,
  inLanguage: 'en',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  author: {
    '@type': 'Person',
    name: 'EGE Patient & RWE Researcher',
    url: `${siteOrigin}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Eosinophilic Gastroenteritis & Intractable Disease Real-World Evidence Portal',
    url: homeUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteOrigin}/icon-512.png`,
    },
  },
  articleSection: category,
  keywords: tags && tags.length > 0 ? tags.join(', ') : category,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home (EN)',
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: `${siteOrigin}/en/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: postUrl,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={eyecatch}
  article={true}
  lang="en"
  originalJaSlug={originalJaSlug}
>
  <!-- Schema.org JSON-LD Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="max-w-4xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-10">
    <!-- Breadcrumbs -->
    <nav class="flex flex-wrap items-center text-xs sm:text-sm text-slate-500 mb-4 sm:mb-6 gap-x-2 gap-y-1 py-0.5">
      <a href="/en/" class="hover:text-teal-700 font-medium shrink-0">Home (EN)</a>
      <span>/</span>
      <span class="text-slate-600 font-medium shrink-0">{category}</span>
      <span>/</span>
      <span class="text-slate-800 font-medium">{title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-5 sm:mb-8 border-b border-slate-200 pb-5 sm:pb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="inline-block px-3.5 py-1 text-xs sm:text-sm font-semibold rounded-full bg-teal-50 text-teal-800 border border-teal-200">
          {category}
        </span>
        <time datetime={pubDate} class="text-xs sm:text-sm text-slate-500">
          Published: {pubDate}
        </time>
        {originalJaSlug && (
          <a
            href={`/blog/${originalJaSlug}`}
            class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full hover:bg-amber-100 transition-colors"
          >
            🇯🇵 日本語版 (Japanese Original)
          </a>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug sm:leading-tight">
        {title}
      </h1>

      {tags && tags.length > 0 && (
        <div class="flex items-center gap-2 mt-5 flex-wrap">
          {tags.map((tag: string) => (
            <span class="text-xs sm:text-sm px-3 py-1 rounded-md bg-slate-100 text-slate-700 border border-slate-200">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Medical Disclaimer Callout (E-E-A-T & AdSense YMYL Policy Compliant) -->
    <div class="mb-8 rounded-xl border-l-4 border-amber-500 bg-amber-50/80 p-5 text-sm sm:text-base text-amber-950 leading-relaxed shadow-xs">
      <div class="font-bold flex items-center gap-2 mb-2 text-amber-900">
        <svg class="w-5 h-5 shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Medical & Scientific Disclaimer</span>
      </div>
      <p>
        The clinical observations, biometric measurements, and pharmacological reviews published on this portal represent longitudinal, de-identified real-world patient data (RWE) and personal investigations into peer-reviewed literature. They do not constitute formal medical diagnoses, clinical prescriptions, or healthcare treatment guidance. Always consult your attending gastroenterologist, neurologist, or healthcare provider before modifying any medication protocol.
      </p>
    </div>

    {eyecatch && (
      <div class="mb-8 rounded-xl overflow-hidden shadow-xs border border-slate-200 bg-slate-100 flex items-center justify-center">
        <img
          src={eyecatch}
          alt={title}
          class="w-full h-auto object-contain max-h-[580px]"
          loading="lazy"
        />
      </div>
    )}

    <!-- Article Content -->
    <div class="prose prose-slate prose-teal lg:prose-lg max-w-none prose-headings:scroll-mt-24 prose-h2:text-2xl sm:prose-h2:3xl prose-h2:font-bold prose-h2:border-b prose-h2:border-slate-200 prose-h2:pb-3 prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl sm:prose-h3:2xl prose-h3:font-bold prose-p:text-base sm:prose-p:lg prose-p:leading-relaxed sm:prose-p:leading-loose text-slate-800">
      <slot />
    </div>

    <!-- Tier-1 Monitization: Recommended Patient Resources & Sponsor Units -->
    <div class="my-10 p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-teal-50/30 border border-slate-200">
      <div class="text-xs font-bold uppercase tracking-wider text-teal-800 mb-2">Verified Patient Clinical Resources</div>
      <h3 class="text-lg font-bold text-slate-900 mb-3">Certified Tools & Global Biomarker References</h3>
      <ul class="text-sm text-slate-700 space-y-2">
        <li class="flex items-start gap-2">
          <span class="text-teal-600 font-bold">•</span>
          <span><strong>Clinical BP Tracking:</strong> Omron Upper-Arm Digital Sphygmomanometer with Dual Morning/Evening Memory Sync.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-teal-600 font-bold">•</span>
          <span><strong>Hypoallergenic Nutrition:</strong> Certified Gluten-Free Elemental Diet & Medical Foods (PubMed Indexed Formulations).</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-teal-600 font-bold">•</span>
          <span><strong>Academic Research:</strong> Open Access clinical trials cataloged via PubMed E-Utilities & ClinicalTrials.gov API.</span>
        </li>
      </ul>
    </div>

    <!-- Bottom In-Article AdSense Unit -->
    <div class="mt-8">
      <AdSense slot="bottom-ad" format="auto" />
    </div>

    <!-- Footer Nav -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm sm:text-base">
      <a
        href="/en/"
        class="inline-flex items-center gap-2 font-semibold text-teal-700 hover:text-teal-800"
      >
        &larr; Back to Research Portal (EN)
      </a>
      <a
        href="/en/research-database"
        class="font-medium text-slate-700 hover:text-slate-900"
      >
        Explore PubMed EGID Clinical Database &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
