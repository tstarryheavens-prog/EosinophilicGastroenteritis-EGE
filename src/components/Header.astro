---
const navItems = [
  { label: 'ホーム', href: '/' },
  { label: '好酸球性消化管疾患', href: '/category/好酸球性消化管疾患' },
  { label: '群発頭痛・頭痛', href: '/category/群発頭痛・頭痛' },
  { label: '重症喘息・呼吸器', href: '/category/重症喘息・呼吸器' },
  { label: '服薬調査', href: '/category/服薬調査・治療薬' },
  { label: '支援の地域差', href: '/regional-support' },
  { label: '難病リンク集', href: '/links' },
  { label: '当サイトについて', href: '/about' }
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- サイトタイトル -->
      <div class="flex-1 min-w-0 pr-4">
        <a href="/" class="group block">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-teal-600 text-white font-bold text-sm shadow-xs group-hover:bg-teal-700 transition-colors">
              EG
            </span>
            <span class="text-base sm:text-lg font-bold text-slate-900 tracking-tight group-hover:text-teal-700 transition-colors truncate">
              好酸球性胃腸炎と複合難病の闘病・服薬ノート
            </span>
          </div>
          <p class="text-xs text-slate-500 hidden sm:block mt-0.5 tracking-wide">
            好酸球性消化管疾患・群発頭痛・重症喘息・小麦アレルギー当事者のリアルな治療・服薬記録
          </p>
        </a>
      </div>

      <!-- 文字サイズ切り替え ＆ デスクトップナビ -->
      <div class="flex items-center gap-3">
        <!-- 文字サイズ切り替えスイッチ -->
        <div class="flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs shrink-0" role="group" aria-label="文字サイズ変更">
          <span class="px-1.5 text-slate-500 font-medium hidden md:inline">文字</span>
          <button
            type="button"
            class="btn-font-normal px-2.5 py-1 rounded-md font-bold transition-all text-slate-600 hover:text-slate-900 data-[active=true]:bg-white data-[active=true]:text-teal-800 data-[active=true]:shadow-xs"
            data-active="true"
            title="標準文字サイズ"
            aria-label="文字サイズを標準にする"
          >
            標準
          </button>
          <button
            type="button"
            class="btn-font-large px-2.5 py-1 rounded-md font-bold transition-all text-slate-600 hover:text-slate-900 data-[active=true]:bg-white data-[active=true]:text-teal-800 data-[active=true]:shadow-xs"
            data-active="false"
            title="文字サイズを大きくする"
            aria-label="文字サイズを大きくする"
          >
            大
          </button>
        </div>

        <!-- デスクトップナビ -->
        <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium">
          {navItems.map(item => (
            <a
              href={item.href}
              class="px-2.5 py-2 rounded-md text-slate-700 hover:text-teal-700 hover:bg-slate-100 transition-colors"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- モバイルメニュー用ボタン -->
        <div class="flex lg:hidden">
          <button
            type="button"
            id="mobile-menu-btn"
            class="inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-hidden"
            aria-label="メニューを開く"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- モバイルメニュー -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1 shadow-lg">
    {navItems.map(item => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-teal-700 hover:bg-slate-50 transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-2 border-t border-slate-100">
      <a href="/disclaimer" class="block px-3 py-1.5 text-sm text-slate-500 hover:text-slate-800">医療免責事項</a>
      <a href="/privacy" class="block px-3 py-1.5 text-sm text-slate-500 hover:text-slate-800">プライバシーポリシー</a>
      <a href="/contact" class="block px-3 py-1.5 text-sm text-slate-500 hover:text-slate-800">お問い合わせ</a>
    </div>
  </div>
</header>

<script is:inline>
  // モバイルメニュートグル
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // 文字サイズ切り替え
  function updateButtons(isLarge) {
    document.querySelectorAll('.btn-font-normal').forEach(b => b.setAttribute('data-active', (!isLarge).toString()));
    document.querySelectorAll('.btn-font-large').forEach(b => b.setAttribute('data-active', isLarge.toString()));
  }

  function initFontSize() {
    try {
      const isLarge = localStorage.getItem('fontSize') === 'large';
      updateButtons(isLarge);
    } catch (e) {}
  }

  document.querySelectorAll('.btn-font-normal').forEach(b => {
    b.addEventListener('click', () => {
      document.documentElement.classList.remove('font-large');
      try { localStorage.setItem('fontSize', 'normal'); } catch (e) {}
      updateButtons(false);
    });
  });

  document.querySelectorAll('.btn-font-large').forEach(b => {
    b.addEventListener('click', () => {
      document.documentElement.classList.add('font-large');
      try { localStorage.setItem('fontSize', 'large'); } catch (e) {}
      updateButtons(true);
    });
  });

  initFontSize();
</script>
