---
const navItems = [
  { label: 'ホーム', href: '/' },
  { label: '好酸球性消化管疾患', href: '/category/好酸球性消化管疾患' },
  { label: '群発頭痛・頭痛', href: '/category/群発頭痛・頭痛' },
  { label: '重症喘息・呼吸器', href: '/category/重症喘息・呼吸器' },
  { label: '服薬調査', href: '/category/服薬調査・治療薬' },
  { label: '論文・治験DB', href: '/research-database', highlight: true },
  { label: '臨床データ解析', href: '/clinical-analytics', highlight: true },
  { label: '支援の地域差', href: '/regional-support' },
  { label: '難病リンク集', href: '/links' },
  { label: '当サイトについて', href: '/about' }
];
---

<header class="bg-[#FDFBF7]/95 backdrop-blur-md border-b border-[#F0EAE1] sticky top-0 z-40 warm-shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 上段: サイトタイトル ＆ ツール（文字サイズ・メニューボタン） -->
    <div class="flex items-center justify-between py-3 border-b border-[#F0EAE1] lg:border-none">
      <!-- サイトタイトル -->
      <div class="flex-1 min-w-0 pr-4">
        <a href="/" class="group block">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-[#E07A5F] text-white font-bold text-sm shadow-xs group-hover:bg-[#D0694E] transition-colors shrink-0">
              EG
            </span>
            <span class="text-lg sm:text-xl font-bold text-[#2C3E35] tracking-tight group-hover:text-[#E07A5F] transition-colors truncate">
              好酸球性胃腸炎と複合難病の闘病・服薬ノート
            </span>
          </div>
          <p class="text-xs text-[#6E685F] hidden sm:block mt-0.5 tracking-wide">
            好酸球性消化管疾患・群発頭痛・重症喘息・小麦アレルギー当事者のリアルな治療・服薬記録
          </p>
        </a>
      </div>

      <!-- 右側ツール: 文字サイズ切り替え ＆ モバイルメニュートグル -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- 文字サイズ切り替えスイッチ -->
        <div class="flex items-center bg-[#F4F1EA] p-1 rounded-xl border border-[#E6DFD3] text-xs shrink-0" role="group" aria-label="文字サイズ変更">
          <span class="px-2 text-[#6E685F] font-bold hidden sm:inline">文字</span>
          <button
            type="button"
            class="btn-font-normal px-3 py-1 rounded-lg font-bold transition-all text-[#3D3A35] hover:bg-[#EFECE6] data-[active=true]:bg-white data-[active=true]:text-[#2C3E35] data-[active=true]:shadow-xs"
            data-active="true"
            title="標準文字サイズ"
            aria-label="文字サイズを標準にする"
          >
            標準
          </button>
          <button
            type="button"
            class="btn-font-large px-3 py-1 rounded-lg font-bold transition-all text-[#3D3A35] hover:bg-[#EFECE6] data-[active=true]:bg-[#E07A5F] data-[active=true]:text-white data-[active=true]:shadow-xs"
            data-active="false"
            title="文字サイズを大きくする"
            aria-label="文字サイズを大きくする"
          >
            大きく
          </button>
        </div>

        <!-- モバイルメニュー用ハンバーガーボタン -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-xl text-[#3D3A35] hover:bg-[#F4F1EA] focus:outline-hidden border border-[#E6DFD3]"
          aria-label="メニューを開く"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 下段: デスクトップナビゲーションバー（lg以上で水平展開、スクロール可能） -->
    <nav class="hidden lg:flex items-center gap-1.5 py-2 overflow-x-auto border-t border-[#F0EAE1] text-sm font-medium scrollbar-none">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`px-3 py-1.5 rounded-xl transition-all whitespace-nowrap shrink-0 flex items-center gap-1.5 ${
            item.highlight
              ? 'text-[#2C3E35] bg-[#81B29A]/20 font-bold hover:bg-[#81B29A]/30 border border-[#81B29A]/40 shadow-xs'
              : 'text-[#3D3A35] hover:text-[#E07A5F] hover:bg-[#F4F1EA]'
          }`}
        >
          {item.highlight && <span class="w-2 h-2 rounded-full bg-[#81B29A] animate-pulse"></span>}
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- モバイルメニュー -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#F0EAE1] bg-[#FDFBF7] px-4 pt-3 pb-4 space-y-1.5 shadow-lg">
    {navItems.map(item => (
      <a
        href={item.href}
        class={`block px-3 py-2 rounded-xl text-base font-bold transition-colors ${
          item.highlight
            ? 'text-[#2C3E35] bg-[#81B29A]/20 border border-[#81B29A]/40'
            : 'text-[#3D3A35] hover:text-[#E07A5F] hover:bg-[#F4F1EA]'
        }`}
      >
        {item.highlight ? `📊 ${item.label}（新着）` : item.label}
      </a>
    ))}
    <div class="pt-2 border-t border-[#F0EAE1] flex flex-wrap gap-2 text-xs">
      <a href="/disclaimer" class="px-2.5 py-1 rounded-lg bg-[#F4F1EA] text-[#6E685F] hover:text-[#3D3A35]">医療免責事項</a>
      <a href="/privacy" class="px-2.5 py-1 rounded-lg bg-[#F4F1EA] text-[#6E685F] hover:text-[#3D3A35]">プライバシーポリシー</a>
      <a href="/contact" class="px-2.5 py-1 rounded-lg bg-[#F4F1EA] text-[#6E685F] hover:text-[#3D3A35]">お問い合わせ</a>
    </div>
  </div>
</header>

<script is:inline>
  // モバイルメニュートグル
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // 文字サイズ切り替え
  function updateButtons(isLarge) {
    document.querySelectorAll('.btn-font-normal').forEach(b => b.setAttribute('data-active', (!isLarge).toString()));
    document.querySelectorAll('.btn-font-large').forEach(b => b.setAttribute('data-active', isLarge.toString()));
  }

  function initFontSize() {
    try {
      const isLarge = localStorage.getItem('fontSize') === 'large';
      updateButtons(isLarge);
    } catch (e) {}
  }

  document.querySelectorAll('.btn-font-normal').forEach(b => {
    b.addEventListener('click', () => {
      document.documentElement.classList.remove('font-large');
      try { localStorage.setItem('fontSize', 'normal'); } catch (e) {}
      updateButtons(false);
    });
  });

  document.querySelectorAll('.btn-font-large').forEach(b => {
    b.addEventListener('click', () => {
      document.documentElement.classList.add('font-large');
      try { localStorage.setItem('fontSize', 'large'); } catch (e) {}
      updateButtons(true);
    });
  });

  initFontSize();
</script>
