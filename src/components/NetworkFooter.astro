---
import { HATENA_BLOG_URL } from '../data/projects';

const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
---

<footer class="nc-footer">
  <div class="nc-container">
    <!-- Nabu Casa Contained Rounded Warm-Gray Footer Panel (#ecebe7) -->
    <div class="nc-footer-panel">
      <div class="nc-footer-grid">
        <!-- Col 1: Brand & Living Lab Identity -->
        <div class="nc-footer-brand">
          <a href={isEn ? '/en/ai-living-lab' : '/ai-living-lab'} class="nc-footer-logo">
            <svg width="28" height="28" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M18 3L32 11V25L18 33L4 25V11L18 3Z" stroke="#1f1f1c" stroke-width="2.2" stroke-linejoin="round" fill="#ffde77"/>
              <path d="M18 3L32 11L18 19L4 11L18 3Z" fill="#ffffff" stroke="#1f1f1c" stroke-width="2.2" stroke-linejoin="round"/>
              <path d="M18 19V33" stroke="#1f1f1c" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
            <div>
              <span class="nc-footer-title">Smart AI Life</span>
              <span class="nc-footer-sub">{isEn ? 'Home Automation & AI Living Lab' : '暮らしとAIの実験室'}</span>
            </div>
          </a>

          <p class="nc-footer-desc">
            {isEn
              ? 'Open engineering documentation and real-world telemetry for home battery HEMS control, 100-year household cash-flow modeling, housing records, and local AI automation.'
              : 'ローカルGPU活用やMCP自動化、家庭用蓄電池（14.9kWh）の自動制御、100歳までの家計計画、注文住宅・高校受験・ウルトラマンまで暮らしの実験記録を公開しています。'}
          </p>

          <div class="nc-author-pill">
            <img src="/pottle_profile.jpg" alt="ぽトル (Pottle)" class="nc-author-avatar" />
            <div>
              <strong>{isEn ? 'Maintained by Pottle' : '運営・執筆：ぽトル (Pottle)'}</strong>
              <span>{isEn ? 'Energy-saving Panda / Living Lab Engineer' : '省エネ脱力パンダ / 暮らしの実験家'}</span>
            </div>
          </div>
        </div>

        <!-- Col 2: Labs -->
        <div class="nc-footer-col">
          <h3 class="nc-footer-heading">{isEn ? 'Labs' : '特設サイト・ラボ'}</h3>
          <ul class="nc-footer-list">
            <li><a href="/ai-hems">⚡ AI Home HEMS（蓄電池・電気代）</a></li>
            <li><a href="/wakwak-money">💰 わくわくマネーラボ（100歳家計）</a></li>
            <li><a href="/toyotahome">🏡 トヨタホーム建築10年記</a></li>
            <li><a href="https://ikomainagoyaaichihighschool.pages.dev" target="_blank" rel="noopener noreferrer">🎓 愛知高校受験ラボ・シミュレーター ↗</a></li>
            <li><a href="/ultraman">👾 ウルトラマン カード＆ソフビ</a></li>
          </ul>
        </div>

        <!-- Col 3: Documentation & Channels -->
        <div class="nc-footer-col">
          <h3 class="nc-footer-heading">{isEn ? 'Resources' : 'ドキュメント・連載'}</h3>
          <ul class="nc-footer-list">
            <li><a href="/articles">📖 全記事データベース</a></li>
            <li><a href="/ai-living-lab/divisions">🧭 ラボ一覧・ロードマップ</a></li>
            <li><a href="/ai-living-lab/craft">🎨 UI/UX Craft Showcase</a></li>
            <li><a href="/en/ai-living-lab">🌐 English Global Edition</a></li>
            <li><a href={HATENA_BLOG_URL} target="_blank" rel="noopener noreferrer">📝 公式はてなブログ連載 ↗</a></li>
            <li><a href="https://www.youtube.com/@PotoRuthege" target="_blank" rel="noopener noreferrer">📺 公式 YouTube (@PotoRuthege) ↗</a></li>
            <li><a href="https://x.com/PotoRuthege" target="_blank" rel="noopener noreferrer">𝕏 公式 X (@PotoRuthege) ↗</a></li>
          </ul>
        </div>

        <!-- Col 4: Policies & Contact -->
        <div class="nc-footer-col">
          <h3 class="nc-footer-heading">{isEn ? 'Legal & Support' : 'サイト情報・規約'}</h3>
          <ul class="nc-footer-list">
            <li><a href="/privacy">🔒 プライバシーポリシー</a></li>
            <li><a href="/privacy#adsense">📊 広告配信（Google AdSense）</a></li>
            <li><a href="/privacy#disclaimer">⚖️ 免責事項・著作権</a></li>
            <li><a href="/contact">📬 お問い合わせ窓口</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Nabu Casa Footer Bottom Row -->
    <div class="nc-footer-bottom">
      <p class="nc-footer-legal">
        当サイトはGoogle AdSenseを含む第三者配信事業者の広告サービスを利用しています。詳細は<a href="/privacy">プライバシーポリシー</a>をご参照ください。
      </p>
      <p class="nc-footer-copy">
        &copy; {new Date().getFullYear()} Smart AI Life (eosinophilicgastroenteritis-ege.pages.dev/ai-living-lab). All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .nc-footer {
    margin-top: 4rem;
    padding-bottom: 2.5rem;
    font-size: 0.9rem;
    color: var(--nc-color-charcoal);
  }

  .nc-footer-panel {
    background-color: var(--nc-color-gray);
    border-radius: var(--nc-radius-md);
    padding: clamp(2rem, 4vw, 3rem);
  }

  .nc-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .nc-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .nc-footer-grid {
      grid-template-columns: 1.7fr 1.1fr 1fr 0.9fr;
      gap: 2.5rem;
    }
  }

  .nc-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nc-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none !important;
    color: var(--nc-color-charcoal);
  }

  .nc-footer-title {
    display: block;
    font-family: var(--nc-font-sans);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--nc-color-charcoal);
  }

  .nc-footer-sub {
    display: block;
    font-family: var(--nc-font-serif);
    font-size: 0.82rem;
    font-weight: 300;
    color: var(--nc-color-taupe);
    margin-top: 0.1rem;
  }

  .nc-footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--nc-color-charcoal);
    opacity: 0.88;
    margin: 0;
  }

  .nc-author-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--nc-color-white);
    padding: 0.65rem 0.95rem;
    border-radius: 0.75rem;
    align-self: flex-start;
  }

  .nc-author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .nc-author-pill strong {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--nc-color-charcoal);
    line-height: 1.25;
  }

  .nc-author-pill span {
    display: block;
    font-size: 0.74rem;
    color: var(--nc-color-taupe);
  }

  .nc-footer-heading {
    font-family: var(--nc-font-serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--nc-color-taupe);
    margin: 0 0 0.85rem;
  }

  .nc-footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .nc-footer-list a {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--nc-color-charcoal);
    text-decoration: none;
  }

  .nc-footer-list a:hover {
    text-decoration: underline;
    text-decoration-color: var(--nc-color-orange);
    text-underline-offset: 0.25em;
  }

  .nc-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--nc-color-taupe);
  }

  @media (min-width: 768px) {
    .nc-footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .nc-footer-legal a {
    color: var(--nc-color-charcoal);
    text-decoration: underline;
    text-decoration-color: var(--nc-color-tin);
  }

  .nc-footer-legal a:hover {
    text-decoration-color: var(--nc-color-orange);
  }
</style>
