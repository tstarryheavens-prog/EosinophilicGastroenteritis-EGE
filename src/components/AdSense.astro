---
interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const { slot = "", format = "auto", className = "" } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_ID || "ca-pub-1988464307898443";
const isConfigured = adsenseClient && !adsenseClient.includes("XXXX");
---

<div class={`my-6 text-center overflow-hidden ad-container ${className}`}>
  <div class="text-[11px] text-slate-400 font-sans tracking-wider mb-1">スポンサーリンク</div>
  {isConfigured ? (
    <ins
      class="adsbygoogle block"
      data-ad-client={adsenseClient}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
  ) : (
    <div class="border border-dashed border-slate-300 rounded-lg p-6 bg-slate-50 text-slate-400 text-xs flex flex-col items-center justify-center min-h-[120px]">
      <span class="font-medium text-slate-500 mb-1">広告表示エリア</span>
      <span>（Google AdSense 審査完了後に自動配信されます）</span>
    </div>
  )}
</div>

<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>
