---
interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const { slot = "", format = "auto", className = "" } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_ID || "ca-pub-1988464307898443";
const isConfigured = adsenseClient && !adsenseClient.includes("XXXX");

// スロットIDのマッピング（環境変数または個別ID設定）
const envSlots: Record<string, string | undefined> = {
  'top-ad': import.meta.env.PUBLIC_ADSENSE_SLOT_TOP,
  'bottom-ad': import.meta.env.PUBLIC_ADSENSE_SLOT_BOTTOM,
  'category-bottom': import.meta.env.PUBLIC_ADSENSE_SLOT_CATEGORY,
};

let effectiveSlot = "";
if (slot && /^\d+$/.test(slot.trim())) {
  effectiveSlot = slot.trim();
} else if (slot && envSlots[slot.trim()]) {
  effectiveSlot = envSlots[slot.trim()]!;
}
---

<div class={`my-8 text-center overflow-hidden ad-container ${className}`}>
  <div class="text-[11px] text-slate-400 font-sans tracking-wider mb-2">スポンサーリンク</div>

  {isConfigured ? (
    <>
      {effectiveSlot ? (
        <!-- Google AdSense 手動ユニット（スロット指定） -->
        <ins
          class="adsbygoogle block"
          style="display:block"
          data-ad-client={adsenseClient}
          data-ad-slot={effectiveSlot}
          data-ad-format={format}
          data-full-width-responsive="true"
        ></ins>
      ) : (
        <!-- Google AdSense レスポンシブ広告ユニット（自動最適化） -->
        <ins
          class="adsbygoogle block"
          style="display:block"
          data-ad-client={adsenseClient}
          data-ad-format={format}
          data-full-width-responsive="true"
        ></ins>
      )}
      <script is:inline>
        try {
          (adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {
          console.debug('AdSense push error:', e);
        }
      </script>
    </>
  ) : (
    <!-- 未設定プレースホルダー -->
    <div class="border border-dashed border-slate-300 rounded-lg p-6 bg-slate-50 text-slate-400 text-xs flex flex-col items-center justify-center min-h-[100px]">
      <span class="font-medium text-slate-500 mb-1">広告表示エリア</span>
      <span>（Google AdSense ID設定待ち）</span>
    </div>
  )}
</div>
