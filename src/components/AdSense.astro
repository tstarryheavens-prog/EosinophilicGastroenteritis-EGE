---
interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const { slot = "", format = "auto", className = "" } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_ID || "ca-pub-1988464307898443";
const isConfigured = adsenseClient && !adsenseClient.includes("XXXX");

// スロットIDのマッピング（環境変数または個別ID設定）
const envSlots: Record<string, string | undefined> = {
  'top-ad': import.meta.env.PUBLIC_ADSENSE_SLOT_TOP,
  'bottom-ad': import.meta.env.PUBLIC_ADSENSE_SLOT_BOTTOM,
  'category-bottom': import.meta.env.PUBLIC_ADSENSE_SLOT_CATEGORY,
  'links-top': import.meta.env.PUBLIC_ADSENSE_SLOT_LINKS_TOP,
  'links-bottom': import.meta.env.PUBLIC_ADSENSE_SLOT_LINKS_BOTTOM,
  'regional-top': import.meta.env.PUBLIC_ADSENSE_SLOT_REGIONAL_TOP,
  'regional-middle': import.meta.env.PUBLIC_ADSENSE_SLOT_REGIONAL_MIDDLE,
};

let effectiveSlot = "";
if (slot && /^\d+$/.test(slot.trim())) {
  effectiveSlot = slot.trim();
} else if (slot && envSlots[slot.trim()]) {
  effectiveSlot = envSlots[slot.trim()]!;
}
---

{isConfigured ? (
  <div class={`my-6 text-center overflow-hidden ad-container ${className}`}>
    <div class="text-[11px] text-slate-400 font-sans tracking-wider mb-1.5">スポンサーリンク</div>
    <ins
      class="adsbygoogle block"
      style="display:block; text-align:center;"
      data-ad-client={adsenseClient}
      {...(effectiveSlot ? { 'data-ad-slot': effectiveSlot } : {})}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      try {
        document.querySelectorAll('ins.adsbygoogle:not([data-ad-pushed])').forEach(function (el) {
          el.setAttribute('data-ad-pushed', 'true');
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        });
      } catch (e) {
        console.debug('AdSense push error:', e);
      }
    </script>
  </div>
) : null}
