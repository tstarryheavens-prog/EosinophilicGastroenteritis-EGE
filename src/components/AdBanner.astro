---
interface Props {
  slotType?: 'auto' | 'infeed' | 'banner' | 'sidebar';
  siteId?:
    | 'aichi-high'
    | 'smartailife'
    | 'ai-hems'
    | 'money'
    | 'wakwak-money'
    | 'home'
    | 'toyotahome'
    | 'hobby-labs'
    | 'ultraman';
  category?: string;
  adSenseSlotId?: string;
  className?: string;
}

const {
  slotType = 'auto',
  siteId = 'smartailife',
  category = '',
  adSenseSlotId,
  className = '',
} = Astro.props;

// AI記事・アーリーアダプター向け判定（AI記事＆技術記事はAdSense専用・A8排除）
const isAIArticle =
  siteId === 'smartailife' ||
  siteId === 'ai-hems' ||
  category === 'decision' ||
  category === 'cloud' ||
  category === 'energy';

// 有効なAdSense広告ユニットIDが指定されているか（ダミーID除外）
const hasValidAdSenseSlot = Boolean(
  adSenseSlotId &&
  adSenseSlotId !== '9876543210' &&
  /^\d{5,}$/.test(adSenseSlotId)
);

const adFormat =
  slotType === 'infeed' ? 'fluid' : slotType === 'banner' ? 'horizontal' : 'auto';

// 非AI記事（教育・家計・住まい・ホビー）向けのフォールバック広告定義
const fallbackAds: Record<string, any> = {
  'aichi-high': {
    badge: '🎓 おすすめ進学・学習支援',
    title: '高校受験・内申点アップ＆合格戦略サポート',
    desc: '愛知・尾張の志望校合格に向けた効率的な学習法・定期テスト対策・最新入試情報。',
    linkUrl: 'https://px.a8.net/svt/ejp?a8mat=4BE70L+662RQI+36T2+TYQVL',
    imgUrl: 'https://www29.a8.net/svt/bgt?aid=261002757373&wid=004&eno=01&mid=s00000014879005033000&mc=1',
    trackUrl: 'https://www12.a8.net/0.gif?a8mat=4BE70L+662RQI+36T2+TYQVL',
    ctaText: '公式プログラム・無料体験を見る ↗',
    width: 300,
    height: 250,
  },
  'smartailife': {
    badge: '🤖 Smart AI Life',
    title: 'AIリビングラボ：自作ツールとAIで暮らしを合理化',
    desc: 'ローカルGPUクラスタ、ECHONET Lite蓄電池制御、自律エージェントの検証ログを公開中。',
    linkUrl: '/ai-living-lab',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'AIリビングラボを見る ↗',
    width: 300,
    height: 250,
  },
  'ai-hems': {
    badge: '⚡ AI Home HEMS',
    title: '卒FIT蓄電池・夜間電力コントロール検証ログ',
    desc: 'ECHONET Liteと実測気象予報を組み合わせた自動充電の記録を公開中。',
    linkUrl: '/ai-hems',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'AI Home HEMSを見る ↗',
    width: 300,
    height: 250,
  },
  'money': {
    badge: '💰 教育費・家計防衛',
    title: '高校・大学進学に向けた家計見直し＆教育資金形成',
    desc: '教育費ダブルピーク期に備える！固定費削減とNISA・住宅ローン返済最適化。',
    linkUrl: 'https://px.a8.net/svt/ejp?a8mat=4BE70L+662RQI+36T2+TYQVL',
    imgUrl: 'https://www29.a8.net/svt/bgt?aid=261002757373&wid=004&eno=01&mid=s00000014879005033000&mc=1',
    trackUrl: 'https://www12.a8.net/0.gif?a8mat=4BE70L+662RQI+36T2+TYQVL',
    ctaText: '家計無料相談・プランニングを見る ↗',
    width: 300,
    height: 250,
  },
  'wakwak-money': {
    badge: '💰 わくわくマネーラボ',
    title: '100歳までの家族キャッシュフローとNISA積立設計',
    desc: '住宅ローンと教育費ピークを乗り切る現実的な資産管理シミュレーターと実体験記。',
    linkUrl: '/wakwak-money',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'わくわくマネーラボへ ↗',
    width: 300,
    height: 250,
  },
  'home': {
    badge: '🏠 住宅ローン・住まい再生',
    title: '新築10年目のメンテナンス・外壁塗装＆蓄電池見積もり比較',
    desc: 'ハウスメーカーの定期点検と適正相場を把握し、住まいのランニングコストを大幅カット。',
    linkUrl: '/toyotahome',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'トヨタホーム実録ポータルを見る ↗',
    width: 300,
    height: 250,
  },
  'toyotahome': {
    badge: '🏡 トヨタホーム実録',
    title: '10年目メンテナンス＆住宅コストシミュレーター',
    desc: '5,200万円ローンの現実、太陽光・蓄電池の実測ROI、保証点検の実体験まとめ。',
    linkUrl: '/toyotahome/cost.html',
    imgUrl: '',
    trackUrl: '',
    ctaText: '費用シミュレーターを見る ↗',
    width: 300,
    height: 250,
  },
  'hobby-labs': {
    badge: '✨ ウルトラマン＆ソフビラボ',
    title: 'UCG 1,400枚検索・デッキ分析＆ソフビ図鑑',
    desc: '親子で遊べるカード図鑑から、ガチ勢のメタ分析・ソフビ塗装記録まで網羅。',
    linkUrl: '/ultraman',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'ウルトラマン特設へ ↗',
    width: 300,
    height: 250,
  },
  'ultraman': {
    badge: '✨ ウルトラマン特設',
    title: 'ウルトラマン カードゲーム全カード検索ビューアー',
    desc: 'レアリティ別・効果別の高速カード検索＆ショップ価格チェック。',
    linkUrl: '/ultraman/viewer/index.html',
    imgUrl: '',
    trackUrl: '',
    ctaText: 'カード検索ビューアーを開く ↗',
    width: 300,
    height: 250,
  },
};

const currentAd = fallbackAds[siteId] || fallbackAds.smartailife;
---

<div class={`nc-ad-container ${className}`}>
  <div class="ad-banner-wrapper nc-ad-card">
    <div class="nc-ad-header">
      <span class="nc-ad-label-official">{isAIArticle ? '📢 スポンサーリンク ｜ Google 広告' : currentAd.badge}</span>
      {!isAIArticle && <span class="nc-ad-label">Sponsored / PR</span>}
    </div>

    {isAIArticle ? (
      /* AI記事：スタディサプリ(A8)は完全排除し、Google AdSenseを常時表示 */
      <div class="adsense-slot nc-adsense-slot">
        <ins class="adsbygoogle"
             style="display:block; text-align:center;"
             data-ad-format={adFormat}
             data-full-width-responsive="true"
             data-ad-client="ca-pub-1988464307898443"
             {...(hasValidAdSenseSlot ? { 'data-ad-slot': adSenseSlotId } : {})}></ins>
      </div>
    ) : (
      /* 非AI記事：Google AdSenseを優先描画し、未配信時のみ関連ナビ/フォールバックへ切替 */
      <>
        <div class="adsense-slot nc-adsense-slot">
          <ins class="adsbygoogle"
               style="display:block; text-align:center;"
               data-ad-format={adFormat}
               data-full-width-responsive="true"
               data-ad-client="ca-pub-1988464307898443"
               {...(hasValidAdSenseSlot ? { 'data-ad-slot': adSenseSlotId } : {})}></ins>
        </div>

        <div class="ad-fallback-card nc-ad-fallback hidden">
          <div class="nc-ad-title">{currentAd.title}</div>
          <p class="nc-ad-desc">{currentAd.desc}</p>

          {currentAd.imgUrl && (
            <div class="nc-ad-media">
              <a href={currentAd.linkUrl} target="_blank" rel="nofollow noopener">
                <img src={currentAd.imgUrl} width={currentAd.width} height={currentAd.height} alt={currentAd.title} class="nc-ad-img" />
              </a>
              {currentAd.trackUrl && <img src={currentAd.trackUrl} width="1" height="1" alt="" style="display:none;" />}
            </div>
          )}

          <div class="nc-ad-cta-wrap">
            <a href={currentAd.linkUrl} target={currentAd.linkUrl.startsWith('/') ? undefined : '_blank'} rel={currentAd.linkUrl.startsWith('/') ? undefined : 'nofollow noopener'} class="btn btn-dark">
              {currentAd.ctaText}
            </a>
          </div>
        </div>
      </>
    )}
  </div>
</div>

<script is:inline>
  (function() {
    var insList = document.querySelectorAll('.ad-banner-wrapper ins.adsbygoogle:not([data-ad-pushed])');
    if (insList.length) {
      insList.forEach(function(ins) {
        ins.setAttribute('data-ad-pushed', 'true');
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      });
    }

    if (!window.__ncAdFallbackScheduled) {
      window.__ncAdFallbackScheduled = true;
      setTimeout(function() {
        document.querySelectorAll('.ad-banner-wrapper').forEach(function(wrapper) {
          var adsenseSlot = wrapper.querySelector('.adsense-slot');
          var fallback = wrapper.querySelector('.ad-fallback-card');
          var ins = wrapper.querySelector('ins.adsbygoogle');

          // フォールバックが存在する場合のみ未配信時切り替え（AI記事などフォールバックなしの場合は切り替えを行わない）
          if (fallback && ins && (ins.getAttribute('data-ad-status') === 'unfilled' || (ins.innerHTML.trim() === '' && ins.offsetHeight < 20))) {
            if (adsenseSlot) adsenseSlot.style.display = 'none';
            fallback.classList.remove('hidden');
          }
        });
      }, 2200);
    }
  })();
</script>

<style>
  .nc-ad-container {
    margin: 2rem 0;
  }

  .nc-ad-card {
    background-color: var(--nc-color-gray);
    border-radius: var(--nc-radius-md);
    padding: 1.25rem 1.5rem;
    color: var(--nc-color-charcoal);
  }

  .nc-ad-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
  }

  .nc-ad-label-official {
    font-size: 0.75rem;
    color: var(--nc-color-taupe, #718096);
    letter-spacing: 0.05em;
  }
  .nc-ad-badge {
    background-color: var(--nc-color-sun);
    color: var(--nc-color-charcoal);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-weight: 500;
  }

  .nc-ad-label {
    font-family: var(--nc-font-serif);
    color: var(--nc-color-taupe);
    font-size: 0.78rem;
  }

  .nc-adsense-slot {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nc-ad-fallback.hidden {
    display: none;
  }

  .nc-ad-fallback {
    text-align: center;
    padding-top: 0.25rem;
  }

  .nc-ad-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--nc-color-charcoal);
    margin-bottom: 0.35rem;
  }

  .nc-ad-desc {
    font-size: 0.85rem;
    color: var(--nc-color-taupe);
    max-width: 540px;
    margin: 0 auto 0.85rem;
  }

  .nc-ad-media {
    display: flex;
    justify-content: center;
    margin: 0.75rem 0;
  }

  .nc-ad-img {
    border-radius: 0.75rem;
    margin: 0 auto;
  }

  .nc-ad-cta-wrap {
    margin-top: 0.85rem;
  }
</style>
