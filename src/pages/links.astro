---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

// 都道府県別データ
const regions = [
  {
    name: "北海道・東北",
    prefectures: [
      { name: "北海道", dept: "保健福祉部感染症対策局感染症対策課", url: "https://www.pref.hokkaido.lg.jp/hf/kkt/nanbyo/", portal: "札幌市 障がい福祉情報", portalUrl: "https://www.city.sapporo.jp/shougai/" },
      { name: "青森県", dept: "健康医療福祉部保健衛生課", url: "https://www.pref.aomori.lg.jp/soshiki/kenko/hoken/nanbyou.html" },
      { name: "岩手県", dept: "保健福祉部健康国保課", url: "https://www.pref.iwate.jp/kurashikankyou/iryou/kenkou/nanbyou/" },
      { name: "宮城県", dept: "保健福祉部疾病・感染症対策課", url: "https://www.pref.miyagi.jp/soshiki/situkan/nanbyo.html", portal: "仙台市 障害福祉情報", portalUrl: "https://www.city.sendai.jp/fukushi/shogai/" },
      { name: "秋田県", dept: "健康環境部保健・疾病対策課", url: "https://www.pref.akita.lg.jp/pages/archive/775" },
