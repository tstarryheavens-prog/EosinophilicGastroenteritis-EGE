      { name: "新潟県", dept: "福祉保健部健康づくり支援課", url: "https://www.pref.niigata.lg.jp/sec/kenko/1217032734177.html" },
      { name: "富山県", dept: "厚生部健康課", url: "https://www.pref.toyama.jp/1205/kenkou/iryou/nanbyou/" },
      { name: "石川県", dept: "健康福祉部健康推進課", url: "https://www.pref.ishikawa.lg.jp/kenkou/nanbyo/" },
      { name: "福井県", dept: "健康福祉部地域医療課", url: "https://www.pref.fukui.lg.jp/doc/iryou/nanbyo/" },
      { name: "山梨県", dept: "福祉保健部健康増進課", url: "https://www.pref.yamanashi.jp/kenko-zsn/nanbyou/" },
      { name: "長野県", dept: "健康福祉部保健・疾病対策課", url: "https://www.pref.nagano.lg.jp/hoken-shippei/kenko/iryo/nanbyo/" },
    ]
  },
  {
    name: "近畿",
    prefectures: [
      { name: "大阪府", dept: "健康医療部保健医療室地域保健課", url: "https://www.pref.osaka.lg.jp/o100060/chiikihoken/nanbyo/", portal: "大阪市 障がい福祉情報", portalUrl: "https://www.city.osaka.lg.jp/fukushi/page/0000004944.html" },
      { name: "兵庫県", dept: "保健医療部疾病対策課", url: "https://web.pref.hyogo.lg.jp/kf17/nanbyo_josei.html", portal: "こうべ障害者支援ネット", portalUrl: "https://www.city.kobe.lg.jp/a52684/kenko/fukushi/shougaishafukushi/" },
      { name: "京都府", dept: "健康福祉部医療課", url: "https://www.pref.kyoto.jp/nanbyo/", portal: "京都市 障害福祉情報ポータル", portalUrl: "https://www.city.kyoto.lg.jp/hokenfukushi/page/0000091395.html" },
      { name: "滋賀県", dept: "健康医療福祉部健康推進課", url: "https://www.pref.shiga.lg.jp/ippan/kenkouiryouhukushi/yakumu/14299.html" },
      { name: "奈良県", dept: "福祉医療部医療政策局疾病対策課", url: "https://www.pref.nara.jp/17926.htm" },
      { name: "和歌山県", dept: "福祉保健部健康局健康推進課", url: "https://www.pref.wakayama.lg.jp/prefg/050100/nanbyo/" },
    ]
  },
  {
    name: "中国・四国",
    prefectures: [
      { name: "広島県", dept: "健康福祉局医療推進課", url: "https://www.pref.hiroshima.lg.jp/soshiki/53/nanbyo.html", portal: "広島市 障害福祉情報", portalUrl: "https://www.city.hiroshima.lg.jp/site/fukushi-shogai/" },
      { name: "岡山県", dept: "保健福祉部健康推進課", url: "https://www.pref.okayama.jp/page/detail-45371.html" },
      { name: "鳥取県", dept: "福祉保健部健康医療局医療政策課", url: "https://www.pref.tottori.lg.jp/nanbyou/" },
      { name: "島根県", dept: "健康福祉部健康推進課", url: "https://www.pref.shimane.lg.jp/medical/kenko/iryo/nanbyo/" },
      { name: "山口県", dept: "健康福祉部健康増進課", url: "https://www.pref.yamaguchi.lg.jp/soshiki/47/22378.html" },
      { name: "徳島県", dept: "保健福祉部健康づくり課", url: "https://www.pref.tokushima.lg.jp/ippannokata/kenko/iryo/2014121500318/" },
      { name: "香川県", dept: "健康福祉部健康づくり相談課", url: "https://www.pref.kagawa.lg.jp/kenkozoshin/nanbyo/" },
      { name: "愛媛県", dept: "保健福祉部健康衛生局健康増進課", url: "https://www.pref.ehime.jp/h25500/nanbyou/" },
      { name: "高知県", dept: "健康政策部健康対策課", url: "https://www.pref.kochi.lg.jp/soshiki/130401/nanbyo-index.html" },
    ]
  },
  {
    name: "九州・沖縄",
    prefectures: [
      { name: "福岡県", dept: "保健医療介護部がん感染症疾病対策課", url: "https://www.pref.fukuoka.lg.jp/contents/nanbyou-top.html", portal: "福岡市 障がい福祉の手引き", portalUrl: "https://www.city.fukuoka.lg.jp/fukushi/shogaishafukushi/" },
      { name: "佐賀県", dept: "健康福祉部健康増進課", url: "https://www.pref.saga.lg.jp/kiji00338782/index.html" },
      { name: "長崎県", dept: "福祉保健部国保・健康増進課", url: "https://www.pref.nagasaki.jp/bunrui/hukushi-hoken/kenkodukuri/nanbyou/" },
      { name: "熊本県", dept: "健康福祉部健康局健康づくり推進課", url: "https://www.pref.kumamoto.jp/soshiki/30/50702.html" },
      { name: "大分県", dept: "福祉保健部健康づくり支援課", url: "https://www.pref.oita.jp/soshiki/12210/nanbyo.html" },
      { name: "宮崎県", dept: "福祉保健部健康増進課", url: "https://www.pref.miyazaki.lg.jp/kenkozoshin/kenko/iryo/nanbyo/" },
      { name: "鹿児島県", dept: "くらし保健福祉部健康増進課", url: "https://www.pref.kagoshima.jp/ae06/kenko-fukushi/kenko-iryo/nanbyo/" },
      { name: "沖縄県", dept: "保健医療介護部健康長寿課", url: "https://www.pref.okinawa.jp/kenko/kenko/1008985/index.html" },
    ]
  }
