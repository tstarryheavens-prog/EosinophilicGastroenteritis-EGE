      { name: "埼玉県", dept: "保健医療部疾病対策課", url: "https://www.pref.saitama.lg.jp/a0705/nanbyou/", portal: "さいたま市 障害福祉ポータル", portalUrl: "https://www.city.saitama.lg.jp/002/003/index.html" },
      { name: "千葉県", dept: "健康福祉部疾病対策課", url: "https://www.pref.chiba.lg.jp/shippei/nanbyou/", portal: "千葉市 障害福祉の手引き", portalUrl: "https://www.city.chiba.jp/hokenfukushi/koreishogai/shogaijiritsu/" },
      { name: "茨城県", dept: "保健医療部疾病対策課", url: "https://www.pref.ibaraki.jp/hokenfukushi/shippei/nanbyo/" },
