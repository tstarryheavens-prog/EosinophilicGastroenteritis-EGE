---
export const prerender = false;
import SmartAIBaseLayout from '../../layouts/SmartAIBaseLayout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { ARTICLES } from '../../data/articles';

const aichiArticles = ARTICLES.filter(
  (a) => a.siteId === 'aichi-high' || a.category === 'education'
);
---

<SmartAIBaseLayout
  title="愛知高校受験ラボ ｜ 内申点×当日点シミュレーター＆受験攻略ガイド"
  description="愛知県公立高校の複合選抜（W出願）やⅠ〜Ⅴ型判定がすぐ分かる合否シミュレーターと、中学生・保護者に役立つ17本の受験対策ガイド。"
>
  <section class="nc-hero hero-green">
    <div class="nc-hero-inner">
      <p class="eyebrow" style="color: #fff; opacity: 0.9;">中学生・保護者向け 進学ガイド</p>
      <h1 class="nc-hero-title">愛知高校受験ラボ</h1>
      <p class="nc-hero-lead">
        愛知県の公立高校入試ならではの「2校受験（複合選抜）」と「内申×当日点の計算方式（Ⅰ〜Ⅴ型）」を分かりやすく整理。内申確定後の三者面談や私立併願の組み立てにお役立てください。
      </p>

      <div style="margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.65rem;">
        <a href="/aichi-high/simulator.html" class="btn btn-sun">🎯 内申点×当日点 合否シミュレーターを使う</a>
        <a href="#aichi-articles" class="btn btn-light">攻略記事一覧を見る（{aichiArticles.length}本）</a>
      </div>
    </div>
  </section>

  <div class="nc-container" style="padding-bottom: 3rem;">
    <a href="/aichi-high/simulator.html" class="nc-sim-banner">
      <div>
        <span class="nc-sim-pill">尾張・名古屋 主要公立高校対応</span>
        <h2 style="margin: 0.4rem 0 0.35rem;">公立高校 内申点×当日点 合否シミュレーター</h2>
        <p style="margin: 0; font-size: 0.94rem; color: #3a3934;">
          9教科の内申点（45点満点）と目標の当日点（110点満点）を入れるだけで、志望校ごとの配点型に合わせた目安や「あと何点必要か」をすぐ計算できます。
        </p>
      </div>
      <span class="btn btn-dark" style="white-space: nowrap;">シミュレーターを開く ↗</span>
    </a>

    <AdBanner slotType="banner" siteId="aichi-high" />

    <section id="aichi-articles" style="margin-top: 1.75rem;">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.25rem;">
        <div>
          <p class="eyebrow">定期テスト・模試・W出願・三者面談</p>
          <h2>愛知県高校受験 攻略記事一覧（全{aichiArticles.length}本）</h2>
        </div>
        <input
          type="search"
          id="ah-search"
          class="nc-inline-search"
          placeholder="キーワード検索（例：内申35、三者面談、私立）"
          aria-label="愛知高校受験記事検索"
        />
      </div>

      <div class="nc-article-grid" id="ah-list">
        {aichiArticles.map((art) => (
          <a
            href={`/articles/${art.slug}`}
            class="nc-article-card"
            data-search={`${art.title} ${art.excerpt} ${art.tags.join(' ')}`.toLowerCase()}
          >
            <div class="nc-card-top">
              <span class="nc-card-badge">{art.categoryLabel}</span>
              <span class="nc-card-date">{art.date} · {art.readTime}</span>
            </div>
            <h3 class="nc-card-title">{art.title}</h3>
            <p class="nc-card-excerpt">{art.excerpt}</p>
            <span class="nc-card-more">詳しく読む →</span>
          </a>
        ))}
      </div>
    </section>

    <div style="margin-top: 2.5rem;">
      <AdBanner slotType="banner" siteId="aichi-high" />
    </div>
  </div>
</SmartAIBaseLayout>

<script is:inline>
  (function () {
    const input = document.getElementById('ah-search');
    const cards = document.querySelectorAll('#ah-list .nc-article-card');
    if (!input || !cards.length) return;
    input.addEventListener('input', function () {
      const q = (input.value || '').trim().toLowerCase();
      cards.forEach(function (card) {
        const text = card.getAttribute('data-search') || '';
        card.style.display = !q || text.includes(q) ? '' : 'none';
      });
    });
  })();
</script>

<style>
  .nc-sim-banner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--nc-color-sun);
    border-radius: 1rem;
    padding: 1.35rem 1.5rem;
    margin-bottom: 1.5rem;
    text-decoration: none !important;
  }
  @media (min-width: 768px) {
    .nc-sim-banner { flex-direction: row; align-items: center; }
  }
  .nc-sim-pill {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    background: var(--nc-color-charcoal);
    color: #fff;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }
  .nc-inline-search {
    width: 100%;
    max-width: 360px;
    padding: 0.65rem 1rem;
    border: 1.5px solid var(--nc-color-charcoal);
    border-radius: 999px;
    font-size: 0.9rem;
    background: #fff;
  }
  .nc-article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }
  .nc-article-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--nc-color-light-gray);
    border-radius: 1rem;
    padding: 1.15rem;
    text-decoration: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .nc-article-card:hover {
    background: var(--nc-color-sun);
    transform: translateY(-2px);
  }
  .nc-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nc-card-badge {
    font-size: 0.74rem;
    font-weight: 600;
    background: #fff;
    color: var(--nc-color-charcoal);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .nc-card-date { font-size: 0.76rem; color: #66655d; }
  .nc-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 0;
    color: var(--nc-color-charcoal);
  }
  .nc-card-excerpt {
    font-size: 0.87rem;
    line-height: 1.55;
    color: #4b4a44;
    margin: 0;
    flex: 1;
  }
  .nc-card-more {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--nc-color-highlight);
  }
</style>
