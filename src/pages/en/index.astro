---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { researchEntries } from '../../data/researchDatabase';

const enPosts = await getCollection('blog_en');
enPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const recentResearch = researchEntries.slice(0, 4);
---

<BaseLayout
  title="Eosinophilic Gastroenteritis & Intractable Disease Real-World Evidence (RWE) Portal"
  description="12-year continuous biometric tracking (4,389 days), clinical pharmacological reviews, and verified PubMed/ClinicalTrials.gov intelligence on Eosinophilic Gastrointestinal Diseases (EGID)."
  lang="en"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-teal-900 via-slate-900 to-slate-950 text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-teal-500/20 text-teal-300 border border-teal-400/30">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          Real-World Evidence (RWE)
        </span>
        <span class="text-xs text-slate-300">
          Continuous Longitudinal Study: 2014 – 2026 (4,389 Days)
        </span>
        <a
          href="/"
          class="ml-auto inline-flex items-center gap-1.5 text-xs font-bold text-amber-300 hover:text-amber-200 bg-amber-500/20 border border-amber-400/30 px-3 py-1 rounded-full transition-colors"
        >
          🇯🇵 日本語トップはこちら
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white mb-6">
        Eosinophilic Gastroenteritis & Intractable Disease <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-300">RWE Portal</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 max-w-3xl leading-relaxed mb-8">
        An open-access scientific archive combining <strong>12 years of multi-parameter daily vital sign telemetry</strong> (8,700+ blood pressure records, nocturnal SpO2, and medication logs) with continuous international trial intelligence from PubMed and ClinicalTrials.gov.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/en/blog/12-year-real-world-vital-data-eosinophilic-gastroenteritis"
          class="px-6 py-3.5 rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-extrabold text-sm sm:text-base shadow-lg shadow-teal-500/25 transition-all transform hover:-translate-y-0.5"
        >
          📊 Read 12-Year Vital Evidence ➔
        </a>
        <a
          href="/en/research-database"
          class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm sm:text-base border border-slate-700 transition-all"
        >
          🔬 Explore PubMed Clinical Trials
        </a>
      </div>
    </div>
  </section>

  <!-- Metric Highlights -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl bg-white shadow-xl border border-slate-200">
      <div class="p-4 rounded-xl bg-slate-50 text-center">
        <div class="text-2xl sm:text-3xl font-black text-teal-700">4,389</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Consecutive Days Tracked</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 text-center">
        <div class="text-2xl sm:text-3xl font-black text-teal-700">8,700+</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Blood Pressure Records</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 text-center">
        <div class="text-2xl sm:text-3xl font-black text-teal-700">3,800+</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">SpO2 Observations</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 text-center">
        <div class="text-2xl sm:text-3xl font-black text-teal-700">100%</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Open-Access De-identified</div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- AdSense Top Banner -->
    <AdSense slot="top-ad" format="auto" className="mb-12" />

    <!-- Featured English Articles -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider text-teal-700">Original Investigations</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Featured Clinical Analyses</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {enPosts.map((post) => (
          <article class="flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:border-teal-300 transition-all">
            {post.data.eyecatch && (
              <a href={`/en/blog/${post.data.slug}`} class="block aspect-video overflow-hidden bg-slate-100">
                <img
                  src={post.data.eyecatch}
                  alt={post.data.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>
            )}
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-bold text-teal-800 bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200">
                    {post.data.category}
                  </span>
                  <time datetime={post.data.pubDate} class="text-xs text-slate-500">
                    {post.data.pubDate}
                  </time>
                </div>
                <h3 class="text-xl font-bold text-slate-900 hover:text-teal-700 transition-colors leading-snug mb-3">
                  <a href={`/en/blog/${post.data.slug}`}>
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="flex flex-wrap gap-1">
                  {post.data.tags.slice(0, 2).map((t: string) => (
                    <span class="text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                      #{t}
                    </span>
                  ))}
                </div>
                <a
                  href={`/en/blog/${post.data.slug}`}
                  class="text-sm font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1"
                >
                  Read Full Paper ➔
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Continuous PubMed Intelligence Preview -->
    <section class="mb-16 p-8 rounded-2xl bg-gradient-to-br from-slate-900 to-teal-950 text-white">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-400">Automated PubMed Crawler</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Latest Global Clinical Trials & Research</h2>
        </div>
        <a
          href="/en/research-database"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs sm:text-sm self-start transition-colors"
        >
          View All {researchEntries.length} Trials ➔
        </a>
      </div>

      <div class="space-y-4">
        {recentResearch.map((item) => (
          <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700 hover:border-teal-500/50 transition-colors">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="text-xs font-bold text-teal-300 bg-teal-950/60 border border-teal-800/80 px-2 py-0.5 rounded">
                {item.source}
              </span>
              <span class="text-xs text-slate-400">{item.pubDate}</span>
              {item.phase && (
                <span class="text-xs text-amber-300 bg-amber-950/60 border border-amber-800/80 px-2 py-0.5 rounded">
                  {item.phase}
                </span>
              )}
            </div>
            <h4 class="text-base font-bold text-white mb-2 leading-snug">
              {item.title}
            </h4>
            <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed">
              {item.academicSummary || item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom AdSense Banner -->
    <AdSense slot="bottom-ad" format="auto" />
  </main>
</BaseLayout>
