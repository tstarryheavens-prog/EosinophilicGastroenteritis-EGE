              {/* 作用機序ボックス */}
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70 text-xs text-slate-600 space-y-1 mb-4">
                <span class="font-bold text-slate-800 block">🔬 分子生物学的メカニズム:</span>
                <p class="leading-relaxed">{item.molecularMechanism}</p>
              </div>
            </div>

            {/* カード下段: 投与方法・製造企業・PMDAリンク */}
            <div class="pt-4 border-t border-slate-100 space-y-2 text-xs">
              <div class="flex items-start justify-between gap-2 text-slate-600">
                <span class="font-semibold text-slate-700 shrink-0">💉 投与方法:</span>
                <span class="text-right">{item.administration}</span>
              </div>
              <div class="flex items-center justify-between gap-2 text-slate-500">
                <span>🏢 開発/販売: {item.company}</span>
                {item.pmdaUrl && (
                  <a
                    href={item.pmdaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 font-bold text-teal-700 hover:text-teal-900 underline"
                  >
                    <span>PMDA添付文書</span>
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 該当なし表示 -->
    <div id="no-results" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 p-8 space-y-3">
      <div class="text-4xl">🔍</div>
      <h3 class="text-lg font-bold text-slate-800">一致するバイオ製剤が見つかりませんでした</h3>
      <p class="text-sm text-slate-500 max-w-md mx-auto">
        別のキーワード（商品名、一般名、適応疾患、標的分子名）をお試しいただくか、カテゴリーフィルターを「全領域」に戻してください。
      </p>
    </div>

    <!-- スポンサーリンク枠 -->
    <div class="mt-16">
      <AdSense format="auto" />
