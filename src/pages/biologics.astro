---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import RakutenBanner from '../components/RakutenBanner.astro';
import { biologicsDatabase, BIOLOGIC_CATEGORIES, type BiologicEntry } from '../data/biologicsDatabase';

const totalBiologics = biologicsDatabase.length;
const categoriesList = Object.entries(BIOLOGIC_CATEGORIES) as [BiologicEntry['category'], typeof BIOLOGIC_CATEGORIES[BiologicEntry['category']]][];
---

<BaseLayout
  title="国内外バイオ製剤（生物学的製剤）完全網羅データベース＆徹底解説"
  description="アレルギー・消化器難病・リウマチ膠原病・頭痛・がん・眼科まで、現代医療を劇的に変革した国内外の主要バイオ製剤（抗体医薬品）を網羅。作用機序、標的分子、適応症、命名規則、医療費制度まで当事者視点で徹底解説。"
>
  <!-- ヒーローヘッダー -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-teal-950 to-slate-950 text-white border-b border-slate-800 py-12 sm:py-20">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f766e15_1px,transparent_1px),linear-gradient(to_bottom,#0f766e15_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- パンくずリスト -->
      <nav class="flex text-xs text-slate-400 mb-6 space-x-2">
        <a href="/" class="hover:text-teal-300 transition-colors">ホーム</a>
        <span>/</span>
        <span class="text-teal-300 font-medium">バイオ製剤完全網羅データベース</span>
      </nav>

      <div class="max-w-4xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/20 border border-teal-400/40 text-teal-300 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          <span>全疾患領域・国内外分子標的抗体・包括的エビデンス集</span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-snug text-white">
          国内外バイオ製剤（生物学的製剤）<br class="hidden sm:inline" />
          完全網羅データベース＆徹底解説
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">
          好酸球性消化管疾患や重症喘息、クローン病・潰瘍性大腸炎、関節リウマチ、片頭痛、抗がん剤（ADC）、認知症治療薬まで。<br class="hidden sm:inline" />
          細胞培養や遺伝子組換え技術から生まれ、従来の化学合成薬では届かなかった病気の根本原因をピンポイントで抑え込む「バイオ製剤（生物学的製剤・抗体医薬）」の国内外主要データを一挙に集約・解説しました。
        </p>

        <!-- メトリクスバッジ -->
        <div class="flex flex-wrap gap-2.5 pt-2 text-xs font-semibold">
          <span class="px-3 py-1.5 rounded-lg bg-slate-800/90 border border-slate-700 text-teal-300">
            📊 収録製剤数: {totalBiologics}品目
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-slate-800/90 border border-slate-700 text-sky-300">
            🏥 対象領域: アレルギー / 消化器 / 膠原病 / 皮膚 / 神経頭痛 / がん / 眼科代謝
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-slate-800/90 border border-slate-700 text-amber-300">
            📑 全件PMDA添付文書・作用機序・標的分子情報つき
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- 医療免責事項コールアウト（AdSense & YMYL準拠） -->
    <div class="mb-10 rounded-xl border-l-4 border-amber-500 bg-amber-50/80 p-5 text-sm sm:text-base text-amber-950 leading-relaxed shadow-2xs">
      <div class="font-bold flex items-center gap-1.5 mb-1.5 text-amber-900">
        <svg class="w-5 h-5 shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>バイオ製剤データベースご利用にあたってのご注意</span>
      </div>
      <p>
        本ページに掲載されている医薬品情報、作用機序、適応症、投与方法等の解説は、医薬品医療機器総合機構（PMDA）の添付文書、厚生労働省審議会公表資料、米国FDA公表データ等の公的公開情報に基づいて作成された教育・啓発用の学術アーカイブです。特定の医薬品の購入・使用を勧誘するものではなく、医師による診断・処方・治療方針の指示を行うものではありません。バイオ製剤の導入や投薬変更の判断は、必ずご自身の担当主治医や専門医療機関にご相談ください。
      </p>
    </div>

    <!-- 基礎講座セクション: バイオ製剤とは？ -->
    <section class="mb-16 bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-10 shadow-sm space-y-8">
      <div class="border-b border-slate-100 pb-5">
        <span class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-800 text-xs font-bold border border-teal-200 mb-2">
          基礎知識ガイド
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          今さら聞けない「バイオ製剤（生物学的製剤）」の基本と仕組み
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          従来の飲み薬と何が違うのか？ なぜ劇的に効き、なぜ高額なのか？ 患者・当事者の視点でわかりやすく解説します。
        </p>
      </div>

      <!-- 3つの特徴カード -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/70 space-y-2.5">
          <div class="text-3xl">⚖️</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">巨大な分子量と精密さ</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            アスピリンなどの従来の低分子医薬品は分子量数百（化学合成）。一方、バイオ製剤は約150,000と数百倍もの大きさを持つ複雑なタンパク質です。鍵穴にピタリとはまる精密機械のように、病気に関わる特定の分子だけを捕捉します。
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/70 space-y-2.5">
          <div class="text-3xl">🎯</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">ピンポイント攻撃と副作用軽減</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            ステロイドのように全身の免疫や代謝を無差別に抑えるのではなく、「炎症を引き起こしている特定の受容体やサイトカイン（IL-4, IL-5, TNF-α等）だけ」をブロック。全身への不要な副作用を抑えつつ、かつてない治療効果を生み出します。
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/70 space-y-2.5">
          <div class="text-3xl">🧬</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">生きた細胞から造られる</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            試験管での化学反応ではなく、チャイニーズハムスター卵巣（CHO）細胞などの生きた培養細胞に遺伝子を組み込んで産生させます。高度な無菌管理と厳格な精製工程が必要なため、製造コストが高く、原則として冷蔵保存が必須です。
          </p>
        </div>
      </div>

      <!-- 構造図・命名規則のビジュアル解説 -->
      <div class="rounded-xl border border-teal-100 bg-teal-50/40 p-6 sm:p-8 space-y-6">
        <h3 class="font-bold text-teal-950 text-lg sm:text-xl flex items-center gap-2">
          <span>🔬</span>
          <span>抗体医薬品の構造と「名前（接尾辞）」に隠されたルール</span>
        </h3>

        <!-- 抗体模式図（インラインSVG・写真引用ルールに則り出典明記） -->
        <div class="bg-white p-5 rounded-xl border border-teal-200/60 shadow-2xs flex flex-col items-center">
          <div class="w-full max-w-lg py-4">
            <!-- 抗体基本構造のSVG図 -->
            <svg viewBox="0 0 500 280" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
              <!-- 背景グリッド装飾 -->
              <rect x="0" y="0" width="500" height="280" fill="#f8fafc" rx="12" />
              <!-- Fab領域とFc領域の点線枠 -->
              <rect x="30" y="20" width="440" height="110" fill="none" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4 4" rx="8" />
              <text x="45" y="40" fill="#0284c7" font-size="12" font-weight="bold">Fab領域（抗原結合部位: 標的分子を捕捉）</text>

              <rect x="140" y="150" width="220" height="115" fill="none" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4 4" rx="8" />
              <text x="150" y="255" fill="#7c3aed" font-size="12" font-weight="bold">Fc領域（エフェクター機能: 免疫細胞結合・体内動態）</text>

              <!-- 抗体のY字構造描画 -->
              <!-- 重鎖左 -->
              <path d="M 120 40 L 190 110 L 220 140 L 220 230" fill="none" stroke="#0d9488" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
              <!-- 重鎖右 -->
              <path d="M 380 40 L 310 110 L 280 140 L 280 230" fill="none" stroke="#0d9488" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
              <!-- 軽鎖左 -->
              <path d="M 90 70 L 160 140" fill="none" stroke="#14b8a6" stroke-width="10" stroke-linecap="round" />
              <!-- 軽鎖右 -->
              <path d="M 410 70 L 340 140" fill="none" stroke="#14b8a6" stroke-width="10" stroke-linecap="round" />

              <!-- ジスルフィド結合 (S-S) -->
              <line x1="220" y1="160" x2="280" y2="160" stroke="#f59e0b" stroke-width="3" stroke-linecap="round" />
              <line x1="220" y1="180" x2="280" y2="180" stroke="#f59e0b" stroke-width="3" stroke-linecap="round" />
              <line x1="150" y1="125" x2="165" y2="110" stroke="#f59e0b" stroke-width="2.5" />
              <line x1="350" y1="125" x2="335" y2="110" stroke="#f59e0b" stroke-width="2.5" />

              <!-- 標的分子（抗原）のイメージ -->
              <circle cx="105" cy="45" r="12" fill="#ef4444" />
              <text x="100" y="49" fill="#ffffff" font-size="11" font-weight="bold">Ag</text>
              <circle cx="395" cy="45" r="12" fill="#ef4444" />
              <text x="390" y="49" fill="#ffffff" font-size="11" font-weight="bold">Ag</text>
            </svg>
          </div>
          <!-- 引用元表記（ルール準拠） -->
          <p class="text-[11px] text-slate-500 mt-2 text-center">
            出典: 国立医薬品食品衛生研究所・PMDA 審査ガイドラインおよび抗体分子構造モデル（IgG骨格）に基づき作成
          </p>
        </div>

        <div class="space-y-3 text-xs sm:text-sm text-slate-700 leading-relaxed">
          <p>
            バイオ製剤の一般名（成分名）の語尾には、世界保健機関（WHO）の国際一般的名称（INN）に基づいた共通ルールがあります。語尾を見るだけで、どのようなタイプの薬かがひと目でわかります。
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
            <div class="bg-white p-3 rounded-lg border border-teal-200/70">
              <span class="font-bold text-teal-800 text-sm block">〜キサマブ (-ximab)</span>
              <span class="text-xs text-slate-500 block mb-1">キメラ抗体（マウス比率約35%）</span>
              <span class="text-xs text-slate-700">例: インフリキシマブ、リツキシマブ</span>
            </div>
            <div class="bg-white p-3 rounded-lg border border-teal-200/70">
              <span class="font-bold text-teal-800 text-sm block">〜ズマブ (-zumab)</span>
              <span class="text-xs text-slate-500 block mb-1">ヒト化抗体（ヒト比率約90%）</span>
              <span class="text-xs text-slate-700">例: メポリズマブ、トシリズマブ</span>
            </div>
            <div class="bg-white p-3 rounded-lg border border-teal-200/70">
              <span class="font-bold text-teal-800 text-sm block">〜ウマブ (-umab)</span>
              <span class="text-xs text-slate-500 block mb-1">完全ヒト型抗体（ヒト比率100%）</span>
              <span class="text-xs text-slate-700">例: デュピルマブ、アダリムマブ</span>
            </div>
            <div class="bg-white p-3 rounded-lg border border-teal-200/70">
              <span class="font-bold text-teal-800 text-sm block">〜セプト (-cept)</span>
              <span class="text-xs text-slate-500 block mb-1">受容体融合タンパク質</span>
              <span class="text-xs text-slate-700">例: エタネルセプト、アフリベルセプト</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 経済的負担と医療費助成制度の案内 -->
      <div class="p-5 sm:p-6 rounded-xl bg-amber-50/70 border border-amber-200/80 space-y-3">
        <h3 class="font-bold text-amber-950 text-base sm:text-lg flex items-center gap-2">
          <span>💳</span>
          <span>高額なバイオ製剤を使い続けるための公的医療制度</span>
        </h3>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          バイオ製剤は1本あたり数万円〜数十万円と非常に高額ですが、日本の公的医療保険制度には患者の自己負担を大幅に抑える仕組みが整備されています。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-slate-800 pt-1">
          <div class="bg-white p-3 rounded-lg border border-amber-200 shadow-2xs">
            <strong class="font-bold text-amber-900 block mb-1">① 高額療養費制度・多数回該当</strong>
            年収に応じた月額上限（例: 年収約370〜770万円なら約8万円）。さらに直近12ヶ月で3回超えると4回目から「多数回該当」で上限が44,400円等に引き下がります。
          </div>
          <div class="bg-white p-3 rounded-lg border border-amber-200 shadow-2xs">
            <strong class="font-bold text-amber-900 block mb-1">② 指定難病医療費受給者証</strong>
            好酸球性消化管疾患、潰瘍性大腸炎、クローン病、全身性エリテマトーデス、重症筋無力症など指定難病に認定されると、自己負担が2割となり月額自己負担上限額（数千円〜2万円）が適用されます。
          </div>
          <div class="bg-white p-3 rounded-lg border border-amber-200 shadow-2xs">
            <strong class="font-bold text-amber-900 block mb-1">③ 企業の健康保険組合「付加給付」</strong>
            大手企業の健保や共済組合では、独自に月額自己負担を2万〜2.5万円程度に抑える「一部負担還元金（付加給付）」制度がある場合が多く、申請により手元負担が激減します。
          </div>
        </div>
        <div class="pt-2 text-right">
          <a href="/medical-cost-simulator" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-teal-800 hover:text-teal-900 underline">
            <span>当サイトの医療費試算シミュレーターで自己負担上限を計算する</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- データベース・コントロールバー（検索＆領域フィルター） -->
    <div class="sticky top-16 z-30 mb-8 p-4 sm:p-5 rounded-2xl bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-sm space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- フリーワード検索バー -->
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="biologic-search-input"
            placeholder="商品名（デュピクセント、オプジーボ等）、一般名、適応疾患、標的分子で検索..."
            class="w-full pl-10 pr-4 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all placeholder:text-slate-400"
          />
        </div>

        <!-- カウント表示 -->
        <div class="flex items-center justify-between md:justify-end gap-3 text-xs sm:text-sm font-bold text-slate-600 shrink-0">
          <span>表示件数: <span id="visible-count" class="text-teal-700 font-extrabold text-base">{totalBiologics}</span> / {totalBiologics} 件</span>
          <button
            type="button"
            id="reset-filter-btn"
            class="px-2.5 py-1 text-xs rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors hidden"
          >
            条件リセット
          </button>
        </div>
      </div>

      <!-- 領域フィルタータブ -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs sm:text-sm">
        <button
          type="button"
          class="category-filter-btn px-3 py-1.5 rounded-xl font-bold transition-all whitespace-nowrap bg-slate-900 text-white shadow-xs"
          data-category="all"
        >
          全領域 ({totalBiologics})
        </button>
        {categoriesList.map(([key, cat]) => {
          const count = biologicsDatabase.filter(b => b.category === key).length;
          return (
            <button
              type="button"
              class="category-filter-btn px-3 py-1.5 rounded-xl font-medium transition-all whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200"
              data-category={key}
            >
              <span class="mr-1">{cat.icon}</span>
              <span>{cat.label}</span>
              <span class="ml-1 text-[11px] opacity-70">({count})</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- バイオ製剤カードグリッド -->
    <div id="biologics-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {biologicsDatabase.map((item) => {
        const catInfo = BIOLOGIC_CATEGORIES[item.category];
        return (
          <article
            class="biologic-card bg-white rounded-2xl border border-slate-200/90 hover:border-teal-400/80 p-6 sm:p-7 shadow-xs hover:shadow-md transition-all flex flex-col justify-between"
            data-category={item.category}
            data-search-text={`${item.brandNameJa} ${item.brandNameEn} ${item.genericNameJa} ${item.genericNameEn} ${item.target} ${item.indications.join(' ')} ${item.company} ${item.description}`}
          >
            <div>
              {/* カード上段: カテゴリバッジ ＆ 標的分子 */}
              <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200">
                  <span>{catInfo.icon}</span>
                  <span>{catInfo.label}</span>
                </span>
                <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-md bg-teal-50 text-teal-800 border border-teal-200 truncate max-w-[220px]" title={item.target}>
                  標的: {item.target}
                </span>
              </div>

              {/* 商品名 ＆ 一般名 */}
              <div class="mb-4">
                <div class="flex items-baseline gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                    {item.brandNameJa}
                  </h3>
                  <span class="text-sm font-semibold text-slate-500">
                    ({item.brandNameEn})
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-teal-800 font-medium mt-0.5">
                  一般名: <span class="font-bold">{item.genericNameJa}</span> <span class="text-xs text-slate-500">[{item.genericNameEn}]</span>
                </p>
                <p class="text-[11px] text-slate-500 mt-0.5">
                  抗体種別: <span class="font-mono">{item.modality}</span>
                </p>
              </div>

              {/* 適応疾患タグ */}
              <div class="mb-4">
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">主な適応症・疾患</div>
                <div class="flex flex-wrap gap-1.5">
                  {item.indications.map((ind) => (
                    <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-50 text-slate-700 border border-slate-200 font-medium">
                      {ind}
