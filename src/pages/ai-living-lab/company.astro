---
// Smart AI Life 統合運営ハブ（カンパニー機能の集約点）
// - 一般公開ページからはリンクしない（middleware / robots.txt / boundary checker で強制）
// - 実運用の司令塔はローカル専用HUD (ASUSTOR NAS Docker :8899)。このページはその入口と境界規約。
export const prerender = false;

import { DIVISIONS_DATA } from "../../data/divisions";
import { ARTICLES } from "../../data/articles";
import { LOCAL_HUD_URL, LOCAL_ADDRESS_REGEX } from "../../data/ops_config";
import { isInternalSiteId } from "../../data/public_scope";

const SITE = "https://ai-living-lab.pages.dev";
const divisions = Object.values(DIVISIONS_DATA);
const latestArticles = ARTICLES.slice(0, 5);
const isLocal = (u?: string) => !!u && LOCAL_ADDRESS_REGEX.test(u);
const now = new Date().toLocaleString("ja-JP", { timeZone: "Asia/Tokyo" });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>統合運営ハブ ｜ Smart AI Life（社内向け）</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #0b0e14;
        --panel: #12161f;
        --panel-2: #181d28;
        --line: rgba(255, 255, 255, 0.09);
        --text: #e8ecf3;
        --muted: #97a1b2;
        --mint: #10b981;
        --sky: #38bdf8;
        --amber: #f59e0b;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: "Plus Jakarta Sans", "Noto Sans JP", -apple-system, sans-serif;
        line-height: 1.7;
      }
      a { color: var(--sky); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px 60px; }
      header.top {
        display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
        padding: 18px 0 14px; border-bottom: 1px solid var(--line); margin-bottom: 22px;
      }
      .kicker {
        font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.1em;
        color: var(--mint); text-transform: uppercase;
      }
      h1 { font-size: 22px; margin: 4px 0 0; letter-spacing: -0.02em; }
      .stamp { margin-left: auto; font-family: "JetBrains Mono", monospace; font-size: 11.5px; color: var(--muted); }
      h2 { font-size: 15px; margin: 0 0 12px; letter-spacing: 0.02em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
      .card {
        background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px;
      }
      .card.primary { border-color: rgba(16, 185, 129, 0.4); background: linear-gradient(180deg, rgba(16,185,129,0.10), var(--panel)); }
      .card h3 { margin: 0 0 6px; font-size: 16px; }
      .card p { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
      .btn {
        display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 8px;
        font-size: 13px; font-weight: 700; background: var(--panel-2); border: 1px solid var(--line); color: var(--text);
      }
      .btn:hover { text-decoration: none; border-color: rgba(56, 189, 248, 0.5); }
      .btn.mint { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.45); color: #6ee7b7; }
      .btn.amber { background: rgba(245, 158, 11, 0.14); border-color: rgba(245, 158, 11, 0.45); color: #fcd34d; }
      .row { display: flex; gap: 10px; flex-wrap: wrap; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-weight: 700; font-size: 11.5px; letter-spacing: 0.05em; text-transform: uppercase; }
      .tag { font-family: "JetBrains Mono", monospace; font-size: 10.5px; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
      .tag.local { color: var(--amber); border-color: rgba(245, 158, 11, 0.4); }
      .tag.public { color: var(--mint); border-color: rgba(16, 185, 129, 0.4); }
      code, pre { font-family: "JetBrains Mono", monospace; }
      pre {
        background: #0d1117; border: 1px solid var(--line); border-radius: 10px; padding: 14px;
        font-size: 12.5px; overflow-x: auto; color: #cbd5e1;
      }
      ul { margin: 0; padding-left: 20px; font-size: 13.5px; }
      li { margin-bottom: 6px; }
      .warn { border-left: 3px solid var(--amber); padding-left: 12px; font-size: 13px; color: #e2e8f0; }
      .sec { margin-top: 26px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <div>
          <div class="kicker">INTERNAL // SMART AI LIFE CORP.</div>
          <h1>統合運営ハブ（カンパニー機能の集約点）</h1>
        </div>
        <div class="stamp">認証済み運営者のみ ｜ {now} JST</div>
      </header>

      <div class="grid">
        <div class="card primary">
          <h3>🎛 メイン司令塔：ローカル専用HUD</h3>
          <p>
            承認キュー・自動入稿・企画スカウト・GPUテレメトリ・全ラボ進捗の実体はローカル（自宅LAN / Docker）でのみ起動します。
            公開エッジ側のこのページは、そこへ戻るためのゲートです。
          </p>
          <div class="row">
            <a class="btn mint" href={LOCAL_HUD_URL} target="_blank" rel="noopener">HUD を開く（:8899）</a>
            <a class="btn" href={`${LOCAL_HUD_URL}/divisions`} target="_blank" rel="noopener">全ラボ ミッションコントロール</a>
            <a class="btn" href={`${LOCAL_HUD_URL}/api/status`} target="_blank" rel="noopener">ヘルスチェック JSON</a>
          </div>
        </div>

        <div class="card">
          <h3>📝 CMS・コンテンツ入稿</h3>
          <p>EmDash 管理画面（Cloudflare Pages / D1）と自律入稿パイプラインの入口。</p>
          <div class="row">
            <a class="btn" href="/_emdash/admin/" target="_blank" rel="noopener">EmDash 管理画面</a>
            <a class="btn" href={`${LOCAL_HUD_URL}/api/publisher_status`} target="_blank" rel="noopener">入稿ワーカー状態</a>
          </div>
          <pre>python3 ai_company/scripts/strata_emdash_publisher.py \
  --site-id aichi-high --slug "my-slug" --title "記事タイトル" --topic "テーマ"</pre>
        </div>

        <div class="card">
          <h3>🌐 公開サイト（読者向け）</h3>
          <p>公開側は記事とテーマ別ラボだけを提供します。運営機能への導線は置いていません。</p>
          <div class="row">
            <a class="btn" href={SITE} target="_blank" rel="noopener">公開トップ</a>
            <a class="btn" href={`${SITE}/articles`} target="_blank" rel="noopener">記事一覧（{ARTICLES.length}本）</a>
            <a class="btn" href={`${SITE}/sitemap.xml`} target="_blank" rel="noopener">sitemap.xml</a>
          </div>
          <ul>
            {latestArticles.map((a) => (
              <li>
                <a href={`${SITE}/articles/${a.slug}`} target="_blank" rel="noopener">{a.title}</a>
                <span class="tag">{a.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="sec">
        <h2>全ラボインデックス（公開ページ ／ LAN内ツールの対応表）</h2>
        <table>
          <thead>
            <tr>
              <th>ラボ</th>
              <th>公開ページ</th>
              <th>LAN内ツール（ローカルのみ）</th>
              <th>状態</th>
            </tr>
          </thead>
          <tbody>
            {divisions.map((div: any) => (
              <tr>
                <td>
                  <strong>{div.icon} {div.shortTitle}</strong><br />
                  <span style="color: var(--muted); font-size: 12px;">{div.subtitle}</span>
                </td>
                <td>
                  {isInternalSiteId(div.id) ? (
                    <>
                      <span class="tag local">一般公開していません（ローカル専用）</span>{" "}
                      <a href={`${LOCAL_HUD_URL}/divisions`} target="_blank" rel="noopener">ローカル専用HUD の {div.shortTitle} カードから開く</a>
                    </>
                  ) : (
                    <a href={`${SITE}/divisions/${div.id}`} target="_blank" rel="noopener">/divisions/{div.id}</a>
                  )}
                  {div.extUrl && !isLocal(div.extUrl) && (
                    <>
                      {" "}<span class="tag public">HP</span>{" "}
                      <a href={div.extUrl} target="_blank" rel="noopener">{div.extLabel || "外部サイト"}</a>
                    </>
                  )}
                  {div.ghUrl && (
                    <>{" "}<span class="tag public">GH</span> <a href={div.ghUrl} target="_blank" rel="noopener">GitHub</a></>
                  )}
                </td>
                <td>
                  {(() => {
                    const localLinks = [
                      ...(div.localUrl ? [div.localUrl] : []),
                      ...((div.features || [])
                        .map((f: any) => f.localLink)
                        .filter((u: any) => !!u && isLocal(u))),
                    ];
                    const unique = Array.from(new Set(localLinks));
                    if (unique.length === 0) return <span class="tag">—</span>;
                    return (
                      <>
                        {unique.map((u: string) => (
                          <>
                            <a href={u} target="_blank" rel="noopener"><span class="tag local">LAN</span> {u}</a>
                            <br />
                          </>
                        ))}
                      </>
                    );
                  })()}
                </td>
                <td><span class="tag">{div.statusLabel}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="sec">
        <h2>公開 / 運営 境界ルール（違反は自動検出）</h2>
        <p class="warn">
          公開ページ（/ ・ /articles ・ /divisions ・ /craft ・ /en ほか）から、
          運営ルート（/dashboard, /company, /_emdash, LAN内アドレス）へ向かう導線は禁止です。
        </p>
        <pre># 静的検査（src と dist を走査）
cd /Volumes/Docker/SmartAILife
npm run check:boundary

# 公開中の本番を実検査
python3 ai_company/scripts/check_public_boundary.py --live</pre>
        <ul>
          <li>運営ルートは <code>src/middleware.ts</code> のゲートで、トークン無しでは 404（API書き込みは 401）として隠蔽されます。</li>
          <li>トークン平文は置かない：<code>src/data/ops_config.ts</code> には SHA-256 のみ。平文は <code>ai_company/config/credentials/ops.credentials.json</code> と <code>.dev.vars</code>（両方 gitignore 済み）。Cloudflare Pages に <code>SLA_OPS_TOKEN</code> を設定すればそちらが優先されます。</li>
          <li>自動入稿スクリプトは <code>ai_company/scripts/emdash_auth.py</code> を import するだけで Authorization ヘッダーが自動付与されます。</li>
          <li>ローカルHUD（<a href="http://192.168.2.100:8899/api/public_boundary" target="_blank" rel="noopener">/api/public_boundary</a>）から公開状況と境界検査をワンクリックで確認できます。</li>
        </ul>
      </div>
    </div>
  </body>
</html>
