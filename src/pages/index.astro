<script is:inline>
  function switchTab(tabId) {
    // 全タブコンテンツを非表示
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    
    // 選択されたタブコンテンツを表示
    const targetContent = document.getElementById(tabId);
    if (targetContent) {
      targetContent.classList.remove('hidden');
    }

    // 全タブボタンのスタイルを標準状態（白背景＋グレー文字）にリセット
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.className = "tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-white text-[#3D3A35] hover:bg-[#FAF6F0] border border-[#E6DFD3] cursor-pointer";
      btn.setAttribute('aria-selected', 'false');
      const arrow = btn.querySelector('span:last-child');
      if (arrow) arrow.className = "text-sm font-bold text-[#8C857B]";
    });

    // 選択されたタブボタンをアクティブスタイル（テラコッタ背景＋白文字＋ソフトシャドウ）に設定
    const activeBtn = document.getElementById('btn-' + tabId);
    if (activeBtn) {
      activeBtn.className = "tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-[#E07A5F] text-white warm-shadow cursor-pointer";
      activeBtn.setAttribute('aria-selected', 'true');
      const arrow = activeBtn.querySelector('span:last-child');
      if (arrow) arrow.className = "text-sm font-bold opacity-90";
    }

    // URLハッシュを更新（履歴を残さず同期）
    try {
      history.replaceState(null, '', '#' + tabId);
    } catch (e) {}
  }

  // 初期化：URLハッシュに対応するタブがあればそれを開く
  window.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash && document.getElementById(hash)) {
      switchTab(hash);
    }
  });
</script>

