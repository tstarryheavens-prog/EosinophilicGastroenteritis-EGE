---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import RakutenBanner from '../components/RakutenBanner.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// カテゴリ別記事件数の集計
const postCounts: Record<string, number> = {};
posts.forEach(p => {
  const c = p.data.category || 'その他';
  postCounts[c] = (postCounts[c] || 0) + 1;
});

const categories = [
  {
    name: '好酸球性消化管疾患',
    description: '指定難病である好酸球性胃腸炎・好酸球性腸炎の診断、入退院、最新の抗体薬・治験情報',
    icon: '🔬',
    bg: 'bg-[#F4F9F6] border-[#D8EAE0]',
    badge: 'bg-[#81B29A] text-white',
    accent: '#81B29A'
  },
  {
    name: '群発頭痛・頭痛',
    description: '「自殺頭痛」とも呼ばれる群発頭痛の激痛発作、片頭痛、CGRP関連薬（アイモビーク等）の記録',
    icon: '⚡',
    bg: 'bg-[#FDF6F0] border-[#F5DFD5]',
    badge: 'bg-[#E07A5F] text-white',
    accent: '#E07A5F'
  },
  {
    name: '重症喘息・呼吸器',
    description: '好酸球性喘息、生物学的製剤（ヌーカラ・エキシデンサー等）、吸入薬（ビレーズトリ）の治療ノート',
    icon: '🫁',
    bg: 'bg-[#F0F5FA] border-[#D6E4F0]',
    badge: 'bg-[#5B8FB9] text-white',
    accent: '#5B8FB9'
  },
  {
    name: '服薬調査・治療薬',
    description: '胃腸薬、神経痛薬（タリージェ等）、漢方薬（大建中湯等）、睡眠薬など実際に処方された薬のまとめ',
    icon: '💊',
    bg: 'bg-[#F5F8F2] border-[#DEE8D5]',
    badge: 'bg-[#769F6B] text-white',
    accent: '#769F6B'
  },
  {
    name: '入院生活・制度',
    description: '10回以上の入院生活で本当に役立った持ち物、大部屋の知恵、難病医療費助成・高額療養費の実態',
    icon: '🏥',
    bg: 'bg-[#F8F4FA] border-[#E8DEF0]',
    badge: 'bg-[#9D81BA] text-white',
    accent: '#9D81BA'
  },
  {
    name: '闘病日記・コラム',
    description: '難病告知からの歩み、家族への想い、小麦完全除去生活（グルテンフリー）の実践と工夫',
    icon: '📖',
    bg: 'bg-[#FDF5F7] border-[#F5D8E0]',
    badge: 'bg-[#D67D8F] text-white',
    accent: '#D67D8F'
  }
];

// カテゴリに応じた温かみのあるプレースホルダースタイル定義
const getCategoryPlaceholderStyle = (category: string) => {
  switch (category) {
    case '好酸球性消化管疾患':
      return { gradient: 'from-[#81B29A] to-[#588157]', icon: '🔬', text: '好酸球性消化管疾患' };
    case '群発頭痛・頭痛':
      return { gradient: 'from-[#E07A5F] to-[#C95D42]', icon: '⚡', text: '群発頭痛・片頭痛' };
    case '重症喘息・呼吸器':
      return { gradient: 'from-[#5B8FB9] to-[#3D6E94]', icon: '🫁', text: '重症喘息・呼吸器' };
    case '服薬調査・治療薬':
      return { gradient: 'from-[#769F6B] to-[#537A49]', icon: '💊', text: '服薬調査・治療薬' };
    case '入院生活・制度':
      return { gradient: 'from-[#9D81BA] to-[#7B5E9C]', icon: '🏥', text: '入院生活・医療費制度' };
    case '闘病日記・コラム':
      return { gradient: 'from-[#D67D8F] to-[#B5596D]', icon: '📖', text: '闘病日記・コラム' };
    default:
      return { gradient: 'from-[#7D766D] to-[#5C554C]', icon: '📋', text: category };
  }
};
---

<BaseLayout>
  <!-- 1画面完結型 Bento Grid ＆ タブ切り替えコンテナ -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 py-4 md:py-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:h-[calc(100vh-130px)] md:min-h-[640px]">
      
      <!-- ================= 左カラム：固定ナビゲーション ＆ 当事者サマリー（4列） ================= -->
      <aside class="md:col-span-4 bg-[#F4F1EA] rounded-3xl p-5 sm:p-6 flex flex-col justify-between border border-[#E6DFD3] warm-shadow overflow-y-auto">
        <div class="space-y-4">
          <!-- やさしいガイドバッジ -->
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 bg-[#81B29A] text-white text-xs font-bold px-3 py-1 rounded-full shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
              当事者 ✕ 10年生体データ
            </span>
          </div>

          <!-- タイトル ＆ メッセージ -->
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-[#2C3E35] leading-snug tracking-tight mb-2">
              好酸球性胃腸炎と<br class="hidden sm:inline" />複合難病の闘病・服薬ノート
            </h1>
            <p class="text-xs sm:text-sm text-[#5C574F] leading-relaxed">
              ひとりじゃない。必要な情報を、すぐ手元に。<br />
              10年間の実測データ解析と、闘病・服薬・暮らしの工夫をタブ切り替えですぐ閲覧できます。
            </p>
          </div>

          <!-- 当事者ステータスバッジ（大きめで見やすい） -->
          <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] sm:text-xs">
            <span class="px-2.5 py-1 rounded-xl bg-white/90 border border-[#E0D8C8] text-[#2C3E35] font-bold shadow-2xs">入退院10回以上</span>
            <span class="px-2.5 py-1 rounded-xl bg-white/90 border border-[#E0D8C8] text-[#2C3E35] font-bold shadow-2xs">在宅酸素経験</span>
            <span class="px-2.5 py-1 rounded-xl bg-white/90 border border-[#E0D8C8] text-[#2C3E35] font-bold shadow-2xs">完全グルテンフリー</span>
            <span class="px-2.5 py-1 rounded-xl bg-white/90 border border-[#E0D8C8] text-[#2C3E35] font-bold shadow-2xs">指定難病受給者証保持</span>
          </div>

          <!-- タブ切り替えナビゲーション（押しやすい大きめのユニバーサルボタン） -->
          <nav class="flex flex-col gap-2.5 pt-2" role="tablist" aria-label="メインコンテンツ切り替え">
            <button
              onclick="switchTab('tab-diseases')"
              id="btn-tab-diseases"
              class="tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-[#E07A5F] text-white warm-shadow cursor-pointer"
              role="tab"
              aria-selected="true"
              aria-controls="tab-diseases"
            >
              <span class="flex items-center gap-2">
                <span class="text-lg">🌱</span>
                <span>疾患・テーマ別カテゴリ</span>
              </span>
              <span class="text-sm font-bold opacity-90">&rarr;</span>
            </button>

            <button
              onclick="switchTab('tab-data')"
              id="btn-tab-data"
              class="tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-white text-[#3D3A35] hover:bg-[#FAF6F0] border border-[#E6DFD3] cursor-pointer"
              role="tab"
              aria-selected="false"
              aria-controls="tab-data"
            >
              <span class="flex items-center gap-2">
                <span class="text-lg">📊</span>
                <span>データ解析・論文DB</span>
              </span>
              <span class="text-sm font-bold text-[#8C857B]">&rarr;</span>
            </button>

            <button
              onclick="switchTab('tab-articles')"
              id="btn-tab-articles"
              class="tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-white text-[#3D3A35] hover:bg-[#FAF6F0] border border-[#E6DFD3] cursor-pointer"
              role="tab"
              aria-selected="false"
              aria-controls="tab-articles"
            >
              <span class="flex items-center gap-2">
                <span class="text-lg">📝</span>
                <span>すべての記事一覧</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-[#F4F1EA] text-[#6E685F]">{sortedPosts.length}件</span>
              </span>
              <span class="text-sm font-bold text-[#8C857B]">&rarr;</span>
            </button>

            <button
              onclick="switchTab('tab-support')"
              id="btn-tab-support"
              class="tab-btn w-full text-left px-4 sm:px-5 py-3.5 rounded-2xl font-bold transition-all flex items-center justify-between bg-white text-[#3D3A35] hover:bg-[#FAF6F0] border border-[#E6DFD3] cursor-pointer"
              role="tab"
              aria-selected="false"
              aria-controls="tab-support"
            >
              <span class="flex items-center gap-2">
                <span class="text-lg">☕</span>
                <span>暮らしの工夫・相談窓口</span>
              </span>
              <span class="text-sm font-bold text-[#8C857B]">&rarr;</span>
            </button>
          </nav>
        </div>

        <!-- 緊急・相談メッセージ常設枠 -->
        <div class="mt-4 pt-3.5 border-t border-[#E0D8C8] text-xs text-[#6E685F] leading-relaxed">
          <div class="flex items-center gap-1.5 font-bold text-[#2C3E35] mb-1">
            <span>💡</span>
            <span>迷ったときは</span>
          </div>
          <p>
            急な体調不良や公的制度の相談は、右側タブの「相談窓口」より専門機関へご相談ください。
          </p>
        </div>
      </aside>

      <!-- ================= 右カラム：コンテンツ表示エリア（8列・内部スクロール対応） ================= -->
      <section class="md:col-span-8 bg-white rounded-3xl p-5 sm:p-7 md:p-8 warm-shadow border border-[#F0EAE1] overflow-y-auto flex flex-col justify-between">
        
        <!-- ================= タブ1：🌱 疾患・テーマ別カテゴリ（初期表示） ================= -->
        <div id="tab-diseases" class="tab-content space-y-5">
          <div class="border-b-2 border-[#F4F1EA] pb-3 flex flex-wrap items-end justify-between gap-2">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#81B29A] uppercase tracking-wider mb-1">
                <span>Category Guide</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-[#2C3E35]">🌱 疾患・テーマ別の基礎知識と記録</h2>
              <p class="text-xs sm:text-sm text-[#6E685F] mt-0.5">当事者が実際に経験・調査したテーマごとに情報を整理しています。</p>
            </div>
            <span class="text-xs font-bold text-[#81B29A] bg-[#F4F9F6] px-3 py-1 rounded-full border border-[#D8EAE0]">
              全6テーマ
            </span>
          </div>

          <!-- Bento Grid: 6カテゴリカード -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
            {categories.map(cat => {
              const count = postCounts[cat.name] || 0;
              return (
                <a
                  href={`/category/${cat.name}`}
                  class={`group p-4 sm:p-5 rounded-2xl border transition-all duration-200 card-hover-fx ${cat.bg} flex flex-col justify-between`}
                >
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-2xl group-hover:scale-110 transition-transform">{cat.icon}</span>
                      <span class={`text-[11px] font-bold px-2 py-0.5 rounded-full ${cat.badge}`}>
                        {count}件
                      </span>
                    </div>
                    <h3 class="font-bold text-[#2C3E35] text-base mb-1.5 group-hover:text-[#E07A5F] transition-colors leading-snug">
                      {cat.name}
                    </h3>
                    <p class="text-xs text-[#5C574F] leading-relaxed line-clamp-3">
                      {cat.description}
                    </p>
                  </div>
                  <div class="pt-3 mt-3 border-t border-black/5 flex items-center justify-between text-xs font-bold text-[#2C3E35] group-hover:text-[#E07A5F]">
                    <span>記事一覧</span>
                    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- カテゴリ補足メッセージ -->
          <div class="bg-[#FDFBF7] p-4 rounded-2xl border border-[#EFECE6] text-xs text-[#6E685F] leading-relaxed">
            <span class="font-bold text-[#2C3E35]">📌 閲覧のヒント：</span>
            各カードをクリックすると、対象疾患に関する詳細な治療経過、処方薬の作用機序、日々の生活上の注意点などの記事をまとめてご覧いただけます。
          </div>
        </div>

        <!-- ================= タブ2：📊 データ解析・論文DB（初期非表示） ================= -->
        <div id="tab-data" class="tab-content hidden space-y-5">
          <div class="border-b-2 border-[#F4F1EA] pb-3 flex flex-wrap items-end justify-between gap-2">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#81B29A] uppercase tracking-wider mb-1">
                <span>Clinical & Vital Analytics</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-[#2C3E35]">📊 10年データ解析 ＆ 論文・治験データベース</h2>
              <p class="text-xs sm:text-sm text-[#6E685F] mt-0.5">Apple Watch・Withingsで蓄積した生ログと国際学術エビデンスを公開。</p>
            </div>
            <a href="/research-database" class="text-xs font-bold text-[#E07A5F] hover:underline flex items-center gap-1">
              論文DB全件 &rarr;
            </a>
          </div>

          <!-- 10年間の実測バイタルメトリクスカード -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3.5 rounded-2xl bg-[#F4F9F6] border border-[#D8EAE0]">
              <div class="text-[11px] text-[#5C574F] font-bold">生体生ログ容量</div>
              <div class="text-xl sm:text-2xl font-extrabold text-[#2C3E35] vital-stat-badge my-0.5">3.14 <span class="text-xs font-bold text-[#6E685F]">GB</span></div>
              <div class="text-[10px] text-[#8C857B]">約1,500万行XML</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#FDF6F0] border border-[#F5DFD5]">
              <div class="text-[11px] text-[#5C574F] font-bold">心拍数測定件数</div>
              <div class="text-xl sm:text-2xl font-extrabold text-[#E07A5F] vital-stat-badge my-0.5">164 <span class="text-xs font-bold text-[#6E685F]">万件</span></div>
              <div class="text-[10px] text-[#8C857B]">Apple Watch常時</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#F0F5FA] border border-[#D6E4F0]">
              <div class="text-[11px] text-[#5C574F] font-bold">歩数記録件数</div>
              <div class="text-xl sm:text-2xl font-extrabold text-[#5B8FB9] vital-stat-badge my-0.5">43 <span class="text-xs font-bold text-[#6E685F]">万件</span></div>
              <div class="text-[10px] text-[#8C857B]">10年間の活動量</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#FDF5F7] border border-[#F5D8E0]">
              <div class="text-[11px] text-[#5C574F] font-bold">特定された入院歴</div>
              <div class="text-xl sm:text-2xl font-extrabold text-[#D67D8F] vital-stat-badge my-0.5">全 10 <span class="text-xs font-bold text-[#6E685F]">回</span></div>
              <div class="text-[10px] text-[#8C857B]">歩数-80%・除水相関</div>
            </div>
          </div>

          <!-- 4大注目特集ポータル（Bento Grid） -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <!-- 特集1: 10年データAI解析新連載 -->
            <a
              href="/blog/ai-health-analytics-ep1-3gb-raw-data-reveal"
              class="group p-5 rounded-2xl bg-[#F4F1EA] border border-[#E6DFD3] hover:border-[#81B29A] transition-all card-hover-fx flex flex-col justify-between"
            >
              <div>
                <span class="inline-block bg-[#81B29A] text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2">
                  🌟 新連載・第1話
                </span>
                <h3 class="font-bold text-base text-[#2C3E35] group-hover:text-[#E07A5F] transition-colors mb-1.5 leading-snug">
                  10年分の生体データ3GBをAIで解剖した話
                </h3>
                <p class="text-xs text-[#5C574F] leading-relaxed">
                  Apple Watch・Withingsの生ログから暴かれた「好酸球炎症 ⇄ 激痛 ⇄ 代謝破綻」の全貌。
                </p>
              </div>
              <div class="pt-3 mt-3 border-t border-[#E0D8C8] flex items-center justify-between text-xs font-bold text-[#81B29A]">
                <span>第1話を読む</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <!-- 特集2: 学術論文＆最新治験データベース -->
            <a
              href="/research-database"
              class="group p-5 rounded-2xl bg-[#F4F1EA] border border-[#E6DFD3] hover:border-[#E07A5F] transition-all card-hover-fx flex flex-col justify-between"
            >
              <div>
                <span class="inline-block bg-[#E07A5F] text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2">
                  📑 論文データベース
                </span>
                <h3 class="font-bold text-base text-[#2C3E35] group-hover:text-[#E07A5F] transition-colors mb-1.5 leading-snug">
                  学術論文・国際治験エビデンスDB
                </h3>
                <p class="text-xs text-[#5C574F] leading-relaxed">
                  NEJMやLancetの主要論文・Phase 3治験を網羅。各論文の1000字要約＆1000字当事者所感を収録。
                </p>
              </div>
              <div class="pt-3 mt-3 border-t border-[#E0D8C8] flex items-center justify-between text-xs font-bold text-[#E07A5F]">
                <span>論文DBを開く</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <!-- 特集3: 臨床データ解析ダッシュボード -->
            <a
              href="/clinical-analytics"
              class="group p-5 rounded-2xl bg-[#F4F1EA] border border-[#E6DFD3] hover:border-[#5B8FB9] transition-all card-hover-fx flex flex-col justify-between"
            >
              <div>
                <span class="inline-block bg-[#5B8FB9] text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2">
                  📊 インタラクティブ
                </span>
                <h3 class="font-bold text-base text-[#2C3E35] group-hover:text-[#E07A5F] transition-colors mb-1.5 leading-snug">
                  臨床データダッシュボード
                </h3>
                <p class="text-xs text-[#5C574F] leading-relaxed">
                  体重推移・安静時心拍数・歩数急落率（-80%）と入院時除水を動的グラフで可視化。
                </p>
              </div>
              <div class="pt-3 mt-3 border-t border-[#E0D8C8] flex items-center justify-between text-xs font-bold text-[#5B8FB9]">
                <span>データを見る</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <!-- 特集4: 地域支援格差 ＆ 全国リンク集 -->
            <a
              href="/regional-support"
              class="group p-5 rounded-2xl bg-[#F4F1EA] border border-[#E6DFD3] hover:border-[#F2CC8F] transition-all card-hover-fx flex flex-col justify-between"
            >
              <div>
                <span class="inline-block bg-[#DDA15E] text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2">
                  🏛️ 支援格差
                </span>
                <h3 class="font-bold text-base text-[#2C3E35] group-hover:text-[#E07A5F] transition-colors mb-1.5 leading-snug">
                  難病支援・自治体助成の地域格差
                </h3>
                <p class="text-xs text-[#5C574F] leading-relaxed">
                  月額手当や見舞金、タクシー券、災害電源等、市区町村独自の助成格差と申請ノウハウ。
                </p>
              </div>
              <div class="pt-3 mt-3 border-t border-[#E0D8C8] flex items-center justify-between text-xs font-bold text-[#DDA15E]">
                <span>格差と申請術を見る</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>
          </div>
        </div>

        <!-- ================= タブ3：📝 すべての記事一覧（初期非表示） ================= -->
        <div id="tab-articles" class="tab-content hidden space-y-5">
