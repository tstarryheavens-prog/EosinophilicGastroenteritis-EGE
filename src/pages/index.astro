<script is:inline>
  (function () {
    const searchInput = document.getElementById('top-article-search');
    const resetBtn = document.getElementById('top-search-reset');
    const pills = document.querySelectorAll('.filter-pill');
    const cards = Array.from(document.querySelectorAll('.article-card'));
    const countBadge = document.getElementById('articles-match-count');
    const emptyBox = document.getElementById('top-articles-empty');
    const expandWrap = document.getElementById('expand-articles-wrap');
    const expandBtn = document.getElementById('btn-expand-articles');

    let activeFilter = 'all';
    let showAll = false;
    const initialLimit = 12;
    const totalCount = cards.length;

    function renderList() {
      const q = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
      const isFiltered = activeFilter !== 'all' || q.length > 0;

      if (resetBtn) {
        resetBtn.classList.toggle('hidden', !isFiltered);
      }

      let matched = 0;
      let shown = 0;

      cards.forEach((card) => {
        const catGroup = card.getAttribute('data-cat-group') || '';
        const blob = card.getAttribute('data-search') || '';
        const matchesCat = activeFilter === 'all' || catGroup === activeFilter;
        const matchesQuery = !q || blob.includes(q);

        if (matchesCat && matchesQuery) {
          matched++;
          if (isFiltered || showAll || shown < initialLimit) {
            card.classList.remove('hidden');
            shown++;
          } else {
            card.classList.add('hidden');
          }
        } else {
          card.classList.add('hidden');
        }
      });

      if (countBadge) {
        if (isFiltered) {
          countBadge.textContent = `絞り込み結果: ${matched}件`;
        } else {
          countBadge.textContent = `表示中: ${shown} / ${totalCount}件`;
        }
      }

      if (emptyBox) {
        emptyBox.classList.toggle('hidden', matched > 0);
      }

      if (expandWrap) {
        const shouldHideExpand = isFiltered || showAll || matched <= initialLimit;
        expandWrap.classList.toggle('hidden', shouldHideExpand);
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeFilter = pill.getAttribute('data-filter') || 'all';
        pills.forEach((p) => {
          const isActive = p === pill;
          p.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            p.className = 'filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#2C3E35] text-white cursor-pointer';
          } else {
            p.className = 'filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#F4F1EA] text-[#3D3A35] hover:bg-[#E6DFD3] cursor-pointer';
          }
        });
        renderList();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', renderList);
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeFilter = 'all';
        pills.forEach((p) => {
          const isAll = p.getAttribute('data-filter') === 'all';
          p.setAttribute('aria-pressed', isAll ? 'true' : 'false');
          p.className = isAll
            ? 'filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#2C3E35] text-white cursor-pointer'
            : 'filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#F4F1EA] text-[#3D3A35] hover:bg-[#E6DFD3] cursor-pointer';
        });
        renderList();
      });
    }

    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        showAll = true;
        renderList();
      });
    }
  })();
</script>
