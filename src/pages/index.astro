---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import RakutenBanner from '../components/RakutenBanner.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// カテゴリ別記事件数の集計
const postCounts: Record<string, number> = {};
posts.forEach(p => {
  const c = p.data.category || 'その他';
  postCounts[c] = (postCounts[c] || 0) + 1;
});

const categories = [
  {
    name: '好酸球性消化管疾患',
    shortName: '好酸球性胃腸炎',
    description: '指定難病「好酸球性胃腸炎」の検査や入院の記録、新しい注射薬や研究の最新情報です。',
    icon: '🔬',
    bg: 'bg-[#F4F9F6] border-[#D8EAE0]',
    badge: 'bg-[#81B29A] text-white',
  },
  {
    name: '群発頭痛・頭痛',
    shortName: '群発頭痛・片頭痛',
    description: '激しい痛みが続く群発頭痛や片頭痛について、予防薬や痛み止めの使い心地を記録しています。',
    icon: '⚡',
    bg: 'bg-[#FDF6F0] border-[#F5DFD5]',
    badge: 'bg-[#E07A5F] text-white',
  },
  {
    name: '重症喘息・呼吸器',
    shortName: '喘息・呼吸器',
    description: '喘息の発作や息苦しさへの向き合い方、吸入薬や注射薬（バイオ製剤）を続けた感想です。',
    icon: '🫁',
    bg: 'bg-[#F0F5FA] border-[#D6E4F0]',
    badge: 'bg-[#5B8FB9] text-white',
  },
  {
    name: '服薬調査・治療薬',
    shortName: 'お薬の記録',
    description: '胃腸薬、神経の痛み止め、漢方薬、睡眠薬など、実際に病院で処方されたお薬のまとめです。',
    icon: '💊',
    bg: 'bg-[#F5F8F2] border-[#DEE8D5]',
    badge: 'bg-[#769F6B] text-white',
  },
  {
    name: '入院生活・制度',
    shortName: '入院・医療費制度',
    description: '10回以上の入院で役立った持ち物、大部屋での過ごし方、医療費助成制度のしくみです。',
    icon: '🏥',
    bg: 'bg-[#F8F4FA] border-[#E8DEF0]',
    badge: 'bg-[#9D81BA] text-white',
  },
  {
    name: '闘病日記・コラム',
    shortName: '闘病記・日々の工夫',
    description: '難病と診断されたときの気持ち、家族のこと、小麦を抜く食事（グルテンフリー）の工夫です。',
    icon: '📖',
    bg: 'bg-[#FDF5F7] border-[#F5D8E0]',
    badge: 'bg-[#D67D8F] text-white',
  }
];

const mainCategoryNames = new Set(categories.map(c => c.name));
const otherCount = posts.filter(p => !mainCategoryNames.has(p.data.category || '')).length;

const INITIAL_SHOW = 12;
const remainingCount = Math.max(0, sortedPosts.length - INITIAL_SHOW);

const vitalsSeries = [
  { ep: '第1話', title: '10年間の体調記録（3.14GB）を整理してわかったこと', href: '/blog/ai-health-analytics-ep1-3gb-raw-data-reveal' },
  { ep: '第2話', title: '全10回の入院と点滴・むくみ改善の体重変化', href: '/blog/ai-health-analytics-ep2-iv-fluid-and-admission-vitals' },
  { ep: '第3話', title: '入院する前の体調サインと歩数の変化', href: '/blog/ai-health-analytics-ep3-admission-timeline-vitals' },
  { ep: '第4話', title: '朝に血圧が急上昇（186/146mmHg）した原因と記録', href: '/blog/ai-health-analytics-ep4-extreme-hypertension-morning-surge' },
  { ep: '第5話', title: '主治医に記録を見せて血圧を落ち着かせるまで（アジルバ）', href: '/blog/ai-health-analytics-ep5-azilsartan-blood-pressure-defense' },
];
---

<BaseLayout>
  <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 py-3 sm:py-6 space-y-6 sm:space-y-10">

    <!-- 1. コンパクト導入 ＆ クイック移動バー -->
    <section class="bg-[#F4F1EA] rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-[#E6DFD3] warm-shadow-sm space-y-3 sm:space-y-4">
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
        <span class="inline-flex items-center gap-1.5 bg-[#81B29A] text-white text-xs font-bold px-2.5 py-0.5 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
          当事者の記録ノート
        </span>
        <span class="px-2 py-0.5 rounded-lg bg-white/90 border border-[#E0D8C8] text-[#2C3E35] text-[11px] font-bold">入院10回以上</span>
        <span class="px-2 py-0.5 rounded-lg bg-white/90 border border-[#E0D8C8] text-[#2C3E35] text-[11px] font-bold">小麦除去生活</span>
        <span class="px-2 py-0.5 rounded-lg bg-white/90 border border-[#E0D8C8] text-[#2C3E35] text-[11px] font-bold">指定難病受給者証</span>
      </div>

      <p class="text-sm sm:text-base text-[#3D3A35] leading-relaxed">
        国の指定難病である<strong>「好酸球性胃腸炎」</strong>をはじめ、群発頭痛・重症喘息・小麦アレルギーと向き合う患者本人の記録ノートです。10回以上の入院経験や、実際に使ったお薬の感想、毎日の食事や医療費の工夫をわかりやすい言葉でまとめています。
      </p>

      <!-- クイック移動バー（スマホ2列・PC4列） -->
      <nav aria-label="ページ内ショートカット" class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3 pt-1">
        <a href="#articles-section" class="flex items-center justify-between gap-1.5 px-3 py-2.5 rounded-xl bg-[#E07A5F] text-white font-bold text-xs sm:text-sm hover:bg-[#D0694E] transition-colors shadow-xs">
          <span class="flex items-center gap-1.5">
            <span>📝</span>
            <span>記事を読む（全{sortedPosts.length}件）</span>
          </span>
          <span>&darr;</span>
        </a>
        <a href="#categories-section" class="flex items-center justify-between gap-1.5 px-3 py-2.5 rounded-xl bg-white text-[#2C3E35] border border-[#E0D8C8] font-bold text-xs sm:text-sm hover:border-[#81B29A] transition-colors">
          <span class="flex items-center gap-1.5">
            <span>🌱</span>
            <span>病気・テーマ別</span>
          </span>
          <span class="text-[#8C857B]">&darr;</span>
        </a>
        <a href="#tools-section" class="flex items-center justify-between gap-1.5 px-3 py-2.5 rounded-xl bg-white text-[#2C3E35] border border-[#E0D8C8] font-bold text-xs sm:text-sm hover:border-[#E07A5F] transition-colors">
          <span class="flex items-center gap-1.5">
            <span>🏥</span>
            <span>持ち物・医療費計算</span>
          </span>
          <span class="text-[#8C857B]">&darr;</span>
        </a>
        <a href="#data-section" class="flex items-center justify-between gap-1.5 px-3 py-2.5 rounded-xl bg-white text-[#2C3E35] border border-[#E0D8C8] font-bold text-xs sm:text-sm hover:border-[#5B8FB9] transition-colors">
          <span class="flex items-center gap-1.5">
            <span>📊</span>
            <span>体調グラフ・新薬</span>
          </span>
          <span class="text-[#8C857B]">&darr;</span>
        </a>
      </nav>
    </section>

    <!-- 2. すぐ使える実用ガイド＆ツール -->
    <section id="tools-section" class="scroll-mt-24 space-y-3">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-lg sm:text-xl font-bold text-[#2C3E35] flex items-center gap-2">
          <span>🛠️</span>
          <span>まず役立つチェックリスト・計算ツール・ガイド</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3.5">
        <a href="/hospitalization-checklist" class="group p-3.5 sm:p-4 rounded-2xl bg-[#FDF6F0] border border-[#F5DFD5] hover:border-[#E07A5F] transition-all card-hover-fx flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xl">🏥</span>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#E07A5F] text-white">チェック保存可</span>
            </div>
            <h3 class="font-bold text-sm sm:text-base text-[#2C3E35] group-hover:text-[#E07A5F] mb-1 leading-snug">
              入院の持ち物チェックリスト
            </h3>
            <p class="text-xs text-[#5C574F] leading-relaxed">
              10回以上の入院で本当に役立った持ち物一覧。画面上でチェックして保存・印刷できます。
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-[#F5DFD5] text-xs font-bold text-[#E07A5F] flex justify-between">
            <span>リストを使う</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/medical-cost-simulator" class="group p-3.5 sm:p-4 rounded-2xl bg-[#F4F9F6] border border-[#D8EAE0] hover:border-[#81B29A] transition-all card-hover-fx flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xl">💰</span>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#81B29A] text-white">かんたん試算</span>
            </div>
            <h3 class="font-bold text-sm sm:text-base text-[#2C3E35] group-hover:text-[#588157] mb-1 leading-snug">
              医療費のかんたん計算ツール
            </h3>
            <p class="text-xs text-[#5C574F] leading-relaxed">
              指定難病の助成と高額療養費を使ったとき、毎月の窓口支払いがいくらになるか計算できます。
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-[#D8EAE0] text-xs font-bold text-[#588157] flex justify-between">
            <span>計算してみる</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/blog/gluten-free-survival-guide" class="group p-3.5 sm:p-4 rounded-2xl bg-white border border-[#E6DFD3] hover:border-[#E07A5F] transition-all card-hover-fx flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xl">🌾</span>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#F4F1EA] text-[#2C3E35]">食事の工夫</span>
            </div>
            <h3 class="font-bold text-sm sm:text-base text-[#2C3E35] group-hover:text-[#E07A5F] mb-1 leading-snug">
              小麦を抜く食事（グルテンフリー）
            </h3>
            <p class="text-xs text-[#5C574F] leading-relaxed">
              小麦アレルギーや胃腸炎でも食べやすい外食メニュー・市販食品の選び方まとめ。
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-[#F0EAE1] text-xs font-bold text-[#E07A5F] flex justify-between">
            <span>ガイドを読む</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/blog/doctor-consultation-1min-sheet" class="group p-3.5 sm:p-4 rounded-2xl bg-white border border-[#E6DFD3] hover:border-[#81B29A] transition-all card-hover-fx flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xl">📋</span>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#F4F1EA] text-[#2C3E35]">診察のコツ</span>
            </div>
            <h3 class="font-bold text-sm sm:text-base text-[#2C3E35] group-hover:text-[#588157] mb-1 leading-snug">
              診察で使える「症状メモ」
            </h3>
            <p class="text-xs text-[#5C574F] leading-relaxed">
              短い診察時間でも、主治医に体調の変化や困りごとを3分で伝えるためのメモ術。
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-[#F0EAE1] text-xs font-bold text-[#588157] flex justify-between">
            <span>メモ術を見る</span>
            <span>&rarr;</span>
          </div>
        </a>
      </div>
    </section>

    <!-- 3. 病気・テーマから探す -->
    <section id="categories-section" class="scroll-mt-24 space-y-3">
      <div class="flex items-end justify-between gap-2">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#2C3E35] flex items-center gap-2">
            <span>🌱</span>
            <span>病気・テーマから探す</span>
          </h2>
          <p class="text-xs text-[#6E685F] mt-0.5">気になるテーマを選ぶと、関連する記事だけをまとめて読めます。</p>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
        {categories.map(cat => {
          const count = postCounts[cat.name] || 0;
          return (
            <a
              href={`/category/${cat.name}`}
              class={`group p-3 sm:p-4 rounded-2xl border transition-all duration-200 card-hover-fx ${cat.bg} flex flex-col justify-between`}
            >
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xl sm:text-2xl">{cat.icon}</span>
                  <span class={`text-[11px] font-bold px-2 py-0.5 rounded-full ${cat.badge}`}>
                    {count}件
                  </span>
                </div>
                <h3 class="font-bold text-[#2C3E35] text-sm sm:text-base mb-1 group-hover:text-[#E07A5F] transition-colors leading-snug">
                  {cat.shortName}
                </h3>
                <p class="text-[11px] sm:text-xs text-[#5C574F] leading-relaxed line-clamp-2">
                  {cat.description}
                </p>
              </div>
              <div class="pt-2 mt-2 border-t border-black/5 flex items-center justify-between text-xs font-bold text-[#2C3E35] group-hover:text-[#E07A5F]">
                <span>一覧を見る</span>
                <span>&rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 4. すべての記事一覧（リアルタイム検索・カテゴリ絞り込み・タイトル全文表示） -->
    <section id="articles-section" class="scroll-mt-24 bg-white rounded-2xl sm:rounded-3xl p-3.5 sm:p-6 border border-[#F0EAE1] warm-shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 border-b border-[#F0EAE1] pb-3">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#2C3E35] flex items-center gap-2">
            <span>📝</span>
            <span>すべての記事一覧（全{sortedPosts.length}件）</span>
          </h2>
          <p class="text-xs text-[#6E685F] mt-0.5">薬の名前や病名で検索したり、テーマボタンで絞り込めます。</p>
        </div>
        <span id="articles-match-count" class="self-start sm:self-auto text-xs font-bold text-[#2C3E35] bg-[#F4F1EA] px-3 py-1 rounded-full border border-[#E6DFD3]">
          表示中: {Math.min(INITIAL_SHOW, sortedPosts.length)} / {sortedPosts.length}件
        </span>
      </div>

      <!-- 検索ボックス＆クリア -->
      <div class="flex gap-2">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-3 flex items-center text-[#8C857B] pointer-events-none">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
          <input
            type="search"
            id="top-article-search"
            placeholder="キーワード検索（例：デュピクセント、入院、頭痛、血圧、小麦...）"
            class="w-full pl-9 pr-3 py-2 text-sm rounded-xl border border-[#D8D0C5] bg-[#FDFBF7] text-[#2C3E35] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#E07A5F]/40 focus:border-[#E07A5F]"
          />
        </div>
        <button
          type="button"
          id="top-search-reset"
          class="hidden px-3 py-2 rounded-xl bg-[#F4F1EA] hover:bg-[#E6DFD3] text-xs font-bold text-[#2C3E35] shrink-0 cursor-pointer"
        >
          解除
        </button>
      </div>

      <!-- カテゴリ絞り込みボタン -->
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="記事のテーマ絞り込み">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#2C3E35] text-white cursor-pointer"
        >
          すべて ({sortedPosts.length})
        </button>
        {categories.map(cat => (
          <button
            type="button"
            data-filter={cat.name}
            aria-pressed="false"
            class="filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#F4F1EA] text-[#3D3A35] hover:bg-[#E6DFD3] cursor-pointer"
          >
            {cat.icon} {cat.shortName} ({postCounts[cat.name] || 0})
          </button>
        ))}
        {otherCount > 0 && (
          <button
            type="button"
            data-filter="__other__"
            aria-pressed="false"
            class="filter-pill px-3 py-1.5 rounded-full text-xs font-bold transition-colors bg-[#F4F1EA] text-[#3D3A35] hover:bg-[#E6DFD3] cursor-pointer"
          >
            📌 最新薬特集・PCメモ ({otherCount})
          </button>
        )}
      </div>

      <!-- 記事グリッド（スマホ：横並びコンパクトカード、PC：3列カード。タイトルは全文表示） -->
      <div id="top-articles-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
        {sortedPosts.map((post, idx) => {
          const cat = post.data.category || 'その他';
          const catGroup = mainCategoryNames.has(cat) ? cat : '__other__';
          const searchBlob = `${post.data.title} ${post.data.description} ${cat} ${(post.data.tags || []).join(' ')}`.toLowerCase();
          return (
            <article
              data-idx={idx}
              data-cat-group={catGroup}
              data-search={searchBlob}
              class={`article-card bg-[#FDFBF7] rounded-xl sm:rounded-2xl border border-[#EFECE6] overflow-hidden hover:border-[#E07A5F] card-hover-fx transition-all duration-200 flex flex-row sm:flex-col ${idx >= INITIAL_SHOW ? 'hidden' : ''}`}
            >
              <a
                href={`/blog/${post.data.slug}`}
                class="w-28 sm:w-full shrink-0 sm:aspect-video overflow-hidden bg-[#F4F1EA] block"
              >
                {post.data.eyecatch ? (
                  <img
                    src={post.data.eyecatch}
                    alt={post.data.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-[#81B29A]/20 flex items-center justify-center text-2xl">📝</div>
                )}
              </a>

              <div class="p-2.5 sm:p-4 flex-1 flex flex-col justify-between min-w-0">
                <div>
                  <div class="flex flex-wrap items-center gap-1.5 mb-1">
                    <span class="text-[10px] sm:text-[11px] font-bold px-1.5 sm:px-2 py-0.5 rounded bg-[#F4F1EA] text-[#2C3E35] border border-[#E6DFD3]">
                      {cat}
                    </span>
                    <time datetime={post.data.pubDate} class="text-[10px] sm:text-[11px] text-[#8C857B]">
                      {post.data.pubDate}
                    </time>
                  </div>

                  <!-- タイトルは省略せずすべて全文表示 -->
                  <h3 class="font-bold text-[#2C3E35] text-sm sm:text-[15px] leading-snug mb-1">
                    <a href={`/blog/${post.data.slug}`} class="hover:text-[#E07A5F] transition-colors">
                      {post.data.title}
                    </a>
                  </h3>

                  <!-- 概要はPC/タブレットのみ1行表示してスマホの縦余白を圧縮 -->
                  <p class="hidden sm:block text-xs text-[#5C574F] line-clamp-1 leading-relaxed mb-2">
                    {post.data.description}
                  </p>
                </div>

                <div class="pt-1.5 sm:pt-2 mt-1 border-t border-[#EFECE6] flex items-center justify-between text-xs">
                  <div class="hidden sm:flex gap-1 overflow-hidden">
                    {(post.data.tags || []).slice(0, 2).map((t: string) => (
                      <span class="text-[#8C857B] text-[10px] bg-white px-1.5 py-0.5 rounded border border-[#E6DFD3]">
                        #{t}
                      </span>
                    ))}
                  </div>
                  <a
                    href={`/blog/${post.data.slug}`}
                    class="font-bold text-[#E07A5F] hover:text-[#D0694E] text-xs ml-auto inline-flex items-center gap-1"
                  >
                    記事を読む &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

