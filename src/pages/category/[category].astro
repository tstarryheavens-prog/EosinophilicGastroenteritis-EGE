---
export const prerender = false;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';

const rawCategory = (Astro.params.category || '').replace(/^\/+|\/+$/g, '');
let category = rawCategory;
try {
  category = decodeURIComponent(rawCategory);
} catch {}

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.category === category)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

if (posts.length === 0) {
  return new Response('Not Found', { status: 404 });
}
---

<BaseLayout title={`${category}の記事一覧`} description={`${category}に関する闘病・お薬の記録記事一覧です。`}>
  <div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-10">
    <!-- パンくずリスト -->
    <nav class="flex text-xs text-[#8C857B] mb-4 space-x-2">
      <a href="/" class="hover:text-[#E07A5F]">ホーム</a>
      <span>/</span>
      <span class="text-[#3D3A35] font-medium">テーマ: {category}</span>
    </nav>

    <header class="mb-5 sm:mb-8 border-b border-[#F0EAE1] pb-4 sm:pb-6">
      <div class="inline-block px-3 py-0.5 rounded-full bg-[#81B29A]/15 text-[#2C3E35] border border-[#81B29A]/30 text-xs font-bold mb-1.5">
        テーマ別記事
      </div>
      <h1 class="text-xl sm:text-3xl font-bold text-[#2C3E35]">
        {category}
      </h1>
      <p class="text-xs sm:text-sm text-[#6E685F] mt-1">
        全 {posts.length} 件の記事
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-5">
      {posts.map(post => (
        <article class="bg-white rounded-xl sm:rounded-2xl border border-[#F0EAE1] warm-shadow-sm overflow-hidden flex flex-row md:flex-col hover:border-[#E07A5F] card-hover-fx transition-all duration-200">
          {post.data.eyecatch && (
            <a href={`/blog/${post.data.slug}`} class="block w-28 md:w-full shrink-0 md:aspect-video overflow-hidden bg-[#F4F1EA]">
              <img
                src={post.data.eyecatch}
                alt={post.data.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
          )}
          <div class="p-3 sm:p-5 flex-1 flex flex-col justify-between min-w-0">
            <div>
              <div class="flex items-center gap-2 mb-1 sm:mb-2">
                <time datetime={post.data.pubDate} class="text-[11px] sm:text-xs text-[#8C857B]">
                  {post.data.pubDate}
                </time>
              </div>
              <h3 class="font-bold text-[#2C3E35] text-sm sm:text-lg mb-1 sm:mb-2 leading-snug">
                <a href={`/blog/${post.data.slug}`} class="hover:text-[#E07A5F] transition-colors">
                  {post.data.title}
                </a>
              </h3>
              <p class="hidden sm:block text-xs sm:text-sm text-[#5C574F] line-clamp-1 leading-relaxed mb-3">
                {post.data.description}
              </p>
            </div>

            <div class="pt-2 border-t border-[#F0EAE1] flex items-center justify-between text-xs sm:text-sm">
              <a
                href={`/blog/${post.data.slug}`}
                class="font-bold text-[#E07A5F] hover:text-[#D0694E] shrink-0 inline-flex items-center gap-1 ml-auto"
              >
                記事を読む &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8">
      <AdSense slot="category-bottom" format="auto" />
    </div>
  </div>
</BaseLayout>
