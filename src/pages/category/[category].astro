---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map(p => p.data.category))];
  return categories.map(category => ({
    params: { category },
    props: {
      category,
      posts: posts.filter(p => p.data.category === category).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
    }
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category}の記事一覧`} description={`${category}に関する闘病・服薬調査記事一覧です。`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- パンくずリスト -->
    <nav class="flex text-xs text-[#8C857B] mb-6 space-x-2">
      <a href="/" class="hover:text-[#E07A5F]">ホーム</a>
      <span>/</span>
      <span class="text-[#3D3A35] font-medium">カテゴリ: {category}</span>
    </nav>

    <header class="mb-8 border-b border-[#F0EAE1] pb-6">
      <div class="inline-block px-3 py-1 rounded-full bg-[#81B29A]/15 text-[#2C3E35] border border-[#81B29A]/30 text-xs font-bold mb-2">
        カテゴリ
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#2C3E35]">
        {category}
      </h1>
      <p class="text-sm text-[#6E685F] mt-1">
        全 {posts.length} 件の記事
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map(post => (
        <article class="bg-white rounded-2xl border border-[#F0EAE1] warm-shadow-sm overflow-hidden flex flex-col hover:border-[#E07A5F] card-hover-fx transition-all duration-200">
          {post.data.eyecatch && (
            <a href={`/blog/${post.data.slug}`} class="block aspect-video overflow-hidden bg-[#F4F1EA]">
              <img
                src={post.data.eyecatch}
                alt={post.data.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
          )}
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <time datetime={post.data.pubDate} class="text-xs sm:text-sm text-[#8C857B]">
                  {post.data.pubDate}
                </time>
              </div>
              <h3 class="font-bold text-[#2C3E35] text-lg sm:text-xl mb-2.5 leading-snug line-clamp-2">
                <a href={`/blog/${post.data.slug}`} class="hover:text-[#E07A5F] transition-colors">
                  {post.data.title}
                </a>
              </h3>
              <p class="text-sm text-[#5C574F] line-clamp-3 leading-relaxed mb-5">
                {post.data.description}
              </p>
            </div>

            <div class="pt-3.5 border-t border-[#F0EAE1] flex items-center justify-between text-sm">
              <a
                href={`/blog/${post.data.slug}`}
                class="font-bold text-[#E07A5F] hover:text-[#D0694E] shrink-0 inline-flex items-center gap-1"
              >
                読む &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12">
      <AdSense slot="category-bottom" format="auto" />
    </div>
  </div>
</BaseLayout>
