---
export const prerender = false;
import SmartAIBaseLayout from '../../layouts/SmartAIBaseLayout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { ARTICLES } from '../../data/articles';

const hemsArticles = ARTICLES.filter(
  (a) =>
    a.siteId === 'ai-hems' ||
    a.slug.includes('hems') ||
    a.slug.includes('solar') ||
    a.slug.includes('battery')
);
---

<SmartAIBaseLayout
  title="AI Home HEMS ｜ 太陽光×14.9kWh蓄電池・電気代最適化ラボ"
  description="深夜電力16.3円と翌日の天気予報を組み合わせてニチコン14.9kWh蓄電池を自動制御する自宅エネルギー管理（ECHONET Lite）の実測レポート。"
>
  <section class="nc-hero hero-charcoal">
    <div class="nc-hero-inner">
      <p class="eyebrow" style="color: #ffde77;">スマートエネルギー・ECHONET Lite 検証ラボ</p>
      <h1 class="nc-hero-title">AI Home HEMS</h1>
      <p class="nc-hero-lead">
        売電終了（卒FIT）後の買電単価（昼間36.0円/kWh）を抑えるため、ニチコン14.9kWh蓄電池とECHONET LiteをPythonで自動制御。高効率ガス給湯器エコジョーズ＋各部屋エアコン構成のリアルな光熱費データを公開しています。
      </p>
    </div>
  </section>

  <div class="nc-container" style="padding-bottom: 3rem;">
    <div class="nc-kpi-strip" style="margin-bottom: 1.5rem;">
      <div class="nc-kpi-box">
        <span class="nc-kpi-label">深夜買電 vs 昼間買電</span>
        <strong class="nc-kpi-value">16.3円 vs 36.0円</strong>
        <span class="nc-kpi-sub">時間帯単価差を自動活用</span>
      </div>
      <div class="nc-kpi-box">
        <span class="nc-kpi-label">導入蓄電池容量</span>
        <strong class="nc-kpi-value">14.9kWh</strong>
        <span class="nc-kpi-sub">ニチコン T5 ハイブリッド</span>
      </div>
      <div class="nc-kpi-box">
        <span class="nc-kpi-label">通信プロトコル</span>
        <strong class="nc-kpi-value">ECHONET Lite</strong>
        <span class="nc-kpi-sub">30秒ごとに実測値を取得</span>
      </div>
    </div>

    <AdBanner slotType="banner" siteId="ai-hems" />

    <section style="margin-top: 1.75rem;">
      <p class="eyebrow">卒FIT・蓄電池・JIT自動充電</p>
      <h2>エネルギー最適化 記事一覧（{hemsArticles.length}本）</h2>
      <div class="nc-article-grid" style="margin-top: 1rem;">
        {hemsArticles.map((art) => (
          <a href={`/articles/${art.slug}`} class="nc-article-card">
            <div class="nc-card-top">
              <span class="nc-card-badge">{art.categoryLabel}</span>
              <span class="nc-card-date">{art.date} · {art.readTime}</span>
            </div>
            <h3 class="nc-card-title">{art.title}</h3>
            <p class="nc-card-excerpt">{art.excerpt}</p>
            <span class="nc-card-more">記事を読む →</span>
          </a>
        ))}
      </div>
    </section>

    <AdBanner slotType="infeed" siteId="ai-hems" />

    <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
      <a href="/toyotahome/solar-battery.html" class="btn btn-dark">☀️ 蓄電池10年収支ページを見る</a>
      <a href="/ai-living-lab" class="btn btn-light">AIリビングラボ トップへ</a>
    </div>

    <div style="margin-top: 2rem;">
      <AdBanner slotType="banner" siteId="ai-hems" />
    </div>
  </div>
</SmartAIBaseLayout>

<style>
  .nc-kpi-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .nc-kpi-box {
    background: var(--nc-color-light-gray);
    border-radius: 0.85rem;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .nc-kpi-label { font-size: 0.76rem; color: #55544d; font-weight: 500; }
  .nc-kpi-value { font-size: 1.3rem; font-weight: 700; color: var(--nc-color-charcoal); }
  .nc-kpi-sub { font-size: 0.75rem; color: #6e6d65; }
  .nc-article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }
  .nc-article-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--nc-color-light-gray);
    border-radius: 1rem;
    padding: 1.15rem;
    text-decoration: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .nc-article-card:hover {
    background: var(--nc-color-sun);
    transform: translateY(-2px);
  }
  .nc-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nc-card-badge {
    font-size: 0.74rem;
    font-weight: 600;
    background: #fff;
    color: var(--nc-color-charcoal);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .nc-card-date { font-size: 0.76rem; color: #66655d; }
  .nc-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 0;
    color: var(--nc-color-charcoal);
  }
  .nc-card-excerpt {
    font-size: 0.87rem;
    line-height: 1.55;
    color: #4b4a44;
    margin: 0;
    flex: 1;
  }
  .nc-card-more {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--nc-color-highlight);
  }
</style>
