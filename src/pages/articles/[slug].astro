<script is:inline>
  // Auto-build Nabu Casa "On this page" TOC from article headings & highlight active section
  (function() {
    var container = document.getElementById('article-content');
    var tocList = document.getElementById('nc-toc-list');
    if (!container || !tocList) return;

    var headings = Array.from(container.querySelectorAll('h2, h3'));
    if (headings.length === 0) return;

    tocList.innerHTML = '';
    var tocLinks = [];

    headings.forEach(function(h, idx) {
      var text = (h.textContent || '').trim();
      if (!text) return;
      if (!h.id) {
        h.id = 'section-' + (idx + 1);
      }
      var li = document.createElement('li');
      li.className = 'nc-toc-item' + (h.tagName.toLowerCase() === 'h3' ? ' is-sub' : '');
      var a = document.createElement('a');
      a.href = '#' + h.id;
      a.className = 'nc-toc-link' + (idx === 0 ? ' is-active' : '');
      a.textContent = text;
      li.appendChild(a);
      tocList.appendChild(li);
      tocLinks.push({ id: h.id, el: h, link: a });
    });

    if ('IntersectionObserver' in window && tocLinks.length > 0) {
      var observer = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var activeId = entry.target.id;
              tocLinks.forEach(function(item) {
                if (item.id === activeId) {
                  item.link.classList.add('is-active');
                } else {
                  item.link.classList.remove('is-active');
                }
              });
            }
          });
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );

      tocLinks.forEach(function(item) {
        observer.observe(item.el);
      });
    }
  })();
</script>

